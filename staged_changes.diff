+        INT_UNSIGNED exchange_id FK "NOT NULL"
+        DECIMAL(18_8) target_price "NOT NULL"
+        VARCHAR(10) condition_type "NOT NULL ('ABOVE' | 'BELOW')"
+        BOOLEAN is_triggered "DEFAULT FALSE"
+        DATETIME created_at "DEFAULT CURRENT_TIMESTAMP"
+    }
