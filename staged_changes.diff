diff --git a/crypto_alerts/public/css/style.css b/crypto_alerts/public/css/style.css
new file mode 100644
index 0000000..bf7e2ec
--- /dev/null
+++ b/crypto_alerts/public/css/style.css
@@ -0,0 +1,107 @@
+/* Custom styles for CryptoAlert SG Split-View UI with Dark/Light Support */
+
+:root {
+  --app-bg: #f4f6f9;
+  --card-border: rgba(0, 0, 0, 0.08);
+  --table-head-bg: #f8f9fa;
+  --transition-speed: 0.2s;
+}
+
+[data-bs-theme="dark"] {
+  --app-bg: #0f1217;
+  --card-border: rgba(255, 255, 255, 0.08);
+  --table-head-bg: #161b22;
+}
+
+body {
+  background-color: var(--app-bg);
+  color: var(--bs-body-color);
+  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
+  min-height: 100vh;
+  transition: background-color var(--transition-speed) ease, color var(--transition-speed) ease;
+}
+
+/* Card & Surface Styling */
+.card {
+  border: 1px solid var(--card-border) !important;
+  transition: background-color var(--transition-speed) ease, border-color var(--transition-speed) ease;
+}
+
+.table th {
+  font-size: 0.82rem;
+  letter-spacing: 0.03em;
+  text-transform: uppercase;
+  color: var(--bs-secondary-color);
+  background-color: var(--table-head-bg) !important;
+}
+
+/* Status Badges */
+.badge-active {
+  background-color: #d1e7dd;
+  color: #0f5132;
+  border: 1px solid #badbcc;
+}
+
+[data-bs-theme="dark"] .badge-active {
+  background-color: rgba(25, 135, 84, 0.2);
+  color: #75b798;
+  border: 1px solid rgba(117, 183, 152, 0.3);
+}
+
+.badge-triggered {
+  background-color: #f8d7da;
+  color: #842029;
+  border: 1px solid #f5c2c7;
+}
+
+[data-bs-theme="dark"] .badge-triggered {
+  background-color: rgba(220, 53, 69, 0.2);
+  color: #ea868f;
+  border: 1px solid rgba(234, 134, 143, 0.3);
+}
+
+/* Triggered Row Highlight in Dark/Light */
+.table-danger-subtle {
+  background-color: rgba(220, 53, 69, 0.08) !important;
+}
+
+[data-bs-theme="dark"] .table-danger-subtle {
