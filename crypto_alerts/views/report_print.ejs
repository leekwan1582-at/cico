<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Deep Coin Analysis Report - <%= report.symbol %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background-color: #f8f9fa;
      color: #212529;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .report-container {
      max-width: 900px;
      margin: 30px auto;
      background: #ffffff;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    }
    .score-badge {
      font-size: 2.2rem;
      font-weight: 800;
      padding: 10px 24px;
      border-radius: 12px;
      display: inline-block;
    }
    .badge-STRONG_BUY { background-color: #198754; color: #fff; }
    .badge-BUY { background-color: #20c997; color: #fff; }
    .badge-NEUTRAL { background-color: #ffc107; color: #212529; }
    .badge-SELL { background-color: #fd7e14; color: #fff; }
    .badge-STRONG_SELL { background-color: #dc3545; color: #fff; }

    .stat-card {
      background-color: #f8f9fa;
      border: 1px solid #dee2e6;
      border-radius: 8px;
      padding: 16px;
      text-align: center;
    }
    .stat-val {
      font-size: 1.4rem;
      font-weight: 700;
    }
    .stat-lbl {
      font-size: 0.85rem;
      color: #6c757d;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .buy-banner {
      background: linear-gradient(135deg, #198754 0%, #157347 100%);
      color: white;
      padding: 20px;
      border-radius: 8px;
      margin-bottom: 24px;
    }

    @media print {
      body {
        background-color: #ffffff;
      }
      .no-print {
        display: none !important;
      }
      .report-container {
        box-shadow: none;
        padding: 0;
        margin: 0;
        max-width: 100%;
      }
    }
  </style>
</head>
<body>

<div class="container my-4 text-end no-print">
  <button class="btn btn-primary btn-sm me-2" onclick="window.print()"><i class="bi bi-printer"></i> Print / Save as PDF</button>
  <button class="btn btn-outline-secondary btn-sm" onclick="window.close()"><i class="bi bi-x-circle"></i> Close</button>
</div>

<div class="report-container">
  <!-- Report Header -->
  <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
    <div>
      <h1 class="h2 fw-bold mb-1"><%= report.symbol %> Deep Asset Analysis</h1>
      <p class="text-muted mb-0"><%= report.name %> &bull; Report #<%= report.id %> &bull; Generated <%= new Date(report.createdAt).toLocaleString() %></p>
    </div>
    <div class="text-end">
      <div class="score-badge badge-<%= report.overallSignal %>">
        <%= report.overallScore %><span style="font-size: 1.1rem; font-weight: normal;">/100</span>
      </div>
      <div class="mt-1 fw-bold text-uppercase" style="letter-spacing: 1px;"><%= report.overallSignal.replace('_', ' ') %></div>
    </div>
  </div>

  <!-- Generational Buy Option Banner -->
  <% if (report.buyOption && report.buyOption.eligible) { %>
    <div class="buy-banner">
      <div class="d-flex align-items-center mb-2">
        <h4 class="mb-0 fw-bold"><%= report.buyOption.badge %></h4>
      </div>
      <p class="mb-2"><%= report.buyOption.rationale %></p>
      <div class="row g-2 mt-2 pt-2 border-top border-white-50">
        <div class="col-sm-4"><strong>Target Entry:</strong> $<%= Number(report.buyOption.targetEntry || 0).toLocaleString() %></div>
        <div class="col-sm-4"><strong>Take Profit:</strong> $<%= Number(report.buyOption.suggestedTakeProfit || 0).toLocaleString() %></div>
        <div class="col-sm-4"><strong>Stop-Loss:</strong> $<%= Number(report.buyOption.suggestedStopLoss || 0).toLocaleString() %></div>
      </div>
    </div>
  <% } %>

  <!-- KPI Overview Grid -->
  <div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
      <div class="stat-card">
        <div class="stat-lbl">Current Price</div>
        <div class="stat-val text-dark">$<%= Number(report.currentPrice || 0).toLocaleString() %></div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card">
        <div class="stat-lbl">Risk Rating</div>
        <div class="stat-val text-primary"><%= report.riskLevel %></div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card">
        <div class="stat-lbl">Technical Score</div>
        <div class="stat-val text-info"><%= report.technicalScore %>/100</div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card">
        <div class="stat-lbl">Sentiment Score</div>
        <div class="stat-val text-warning"><%= report.sentimentScore %>/100</div>
      </div>
    </div>
  </div>

  <!-- Executive Summary -->
  <div class="card mb-4 border-0 bg-light">
    <div class="card-body">
      <h5 class="fw-bold mb-3"><i class="bi bi-card-text text-primary me-2"></i>Executive Summary</h5>
      <p class="mb-0" style="white-space: pre-line; line-height: 1.6;"><%= report.summaryText %></p>
    </div>
  </div>

  <!-- Macro & Technical Indicators Breakdown -->
  <div class="row g-4 mb-4">
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-header bg-white fw-bold"><i class="bi bi-graph-up text-success me-2"></i>Macro & Moving Averages</div>
        <div class="card-body p-0">
          <table class="table table-sm mb-0">
            <tbody>
              <tr>
                <td class="text-muted ps-3">200-Week SMA</td>
                <td class="fw-bold text-end pe-3">
                  <% if (report.metrics && report.metrics.sma200wEval && report.metrics.sma200wEval.sma200w) { %>
                    $<%= Number(report.metrics.sma200wEval.sma200w).toLocaleString() %>
                    <span class="badge <%= report.metrics.sma200wEval.isAtOrBelow200w ? 'bg-success' : 'bg-secondary' %> ms-1">
                      <%= report.metrics.sma200wEval.distancePct %>%
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary fw-normal">
                      <%= (report.metrics && report.metrics.sma200wEval && report.metrics.sma200wEval.reason) || 'Insufficient data (<200w)' %>
                    </span>
                  <% } %>
                </td>
              </tr>
              <tr>
                <td class="text-muted ps-3">50-Day SMA</td>
                <td class="fw-bold text-end pe-3">
                  <% if (report.metrics && report.metrics.technicals && report.metrics.technicals.sma50) { %>
                    $<%= Number(Number(report.metrics.technicals.sma50).toFixed(2)).toLocaleString() %>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary fw-normal">Insufficient data (&lt;50d)</span>
                  <% } %>
                </td>
              </tr>
              <tr>
                <td class="text-muted ps-3">200-Day SMA</td>
                <td class="fw-bold text-end pe-3">
                  <% if (report.metrics && report.metrics.technicals && report.metrics.technicals.sma200) { %>
                    $<%= Number(Number(report.metrics.technicals.sma200).toFixed(2)).toLocaleString() %>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary fw-normal">
                      <%= (report.metrics && report.metrics.technicals && report.metrics.technicals.reasons && report.metrics.technicals.reasons.sma200d) || 'Insufficient data (<200d)' %>
                    </span>
                  <% } %>
                </td>
              </tr>
              <tr>
                <td class="text-muted ps-3">Support (BB Lower)</td>
                <td class="fw-bold text-success text-end pe-3"><%= report.supportPrice ? '$' + Number(report.supportPrice).toLocaleString() : 'N/A' %></td>
              </tr>
              <tr>
                <td class="text-muted ps-3">Resistance (BB Upper)</td>
                <td class="fw-bold text-danger text-end pe-3"><%= report.resistancePrice ? '$' + Number(report.resistancePrice).toLocaleString() : 'N/A' %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-header bg-white fw-bold"><i class="bi bi-activity text-info me-2"></i>Momentum & Volatility</div>
        <div class="card-body p-0">
          <table class="table table-sm mb-0">
            <tbody>
              <tr>
                <td class="text-muted ps-3">RSI (14)</td>
                <td class="fw-bold text-end pe-3"><%= report.metrics && report.metrics.technicals && report.metrics.technicals.rsi14 !== null ? report.metrics.technicals.rsi14 : 'N/A' %></td>
              </tr>
              <tr>
                <td class="text-muted ps-3">MACD Histogram</td>
                <td class="fw-bold text-end pe-3"><%= report.metrics && report.metrics.technicals && report.metrics.technicals.macd ? report.metrics.technicals.macd.histogram : 'N/A' %></td>
              </tr>
              <tr>
                <td class="text-muted ps-3">Bollinger Squeeze</td>
                <td class="fw-bold text-end pe-3"><%= report.metrics && report.metrics.technicals && report.metrics.technicals.bollingerBands && report.metrics.technicals.bollingerBands.isSqueeze ? 'YES (Impending)' : 'NO' %></td>
              </tr>
              <tr>
                <td class="text-muted ps-3">Average True Range (ATR)</td>
                <td class="fw-bold text-end pe-3"><%= report.metrics && report.metrics.technicals && report.metrics.technicals.atr ? '$' + Number(report.metrics.technicals.atr).toLocaleString() : 'N/A' %></td>
              </tr>
              <tr>
                <td class="text-muted ps-3">Fear & Greed Index</td>
                <td class="fw-bold text-end pe-3"><%= report.metrics && report.metrics.sentiment && report.metrics.sentiment.fearAndGreed ? report.metrics.sentiment.fearAndGreed.value + ' (' + report.metrics.sentiment.fearAndGreed.classification + ')' : 'N/A' %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="text-center text-muted small pt-3 border-top">
    CryptoAlerts Deep Market Intelligence &bull; Not financial advice. For informational & automated trading alert configuration only.
  </div>
</div>

</body>
</html>