<div class="dropdown">
  <button
    class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-1 text-light border-secondary"
    type="button"
    id="themeDropdown"
    data-bs-toggle="dropdown"
    aria-expanded="false"
    title="Change Theme"
  >
    <span id="theme-current-icon">🌓</span>
    <span class="d-none d-sm-inline" id="theme-current-text">Auto</span>
  </button>
  <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="themeDropdown">
    <li>
      <button class="dropdown-item d-flex align-items-center gap-2" type="button" data-theme-value="light">
        <span>☀️</span> Light
      </button>
    </li>
    <li>
      <button class="dropdown-item d-flex align-items-center gap-2" type="button" data-theme-value="dark">
        <span>🌙</span> Dark
      </button>
    </li>
    <li>
      <button class="dropdown-item d-flex align-items-center gap-2" type="button" data-theme-value="auto">
        <span>🌓</span> System (Auto)
      </button>
    </li>
  </ul>
</div>
