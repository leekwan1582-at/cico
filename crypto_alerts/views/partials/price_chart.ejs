<div class="card shadow-sm mb-4 border-0">
  <div class="card-header bg-body-tertiary d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="fw-semibold text-body d-flex align-items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-graph-up text-primary" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M0 0h1v15h15v1H0zm14.817 3.113a.5.5 0 0 1 .07.704l-4.5 5.5a.5.5 0 0 1-.74.037L7.06 6.767l-3.656 5.027a.5.5 0 0 1-.808-.588l4-5.5a.5.5 0 0 1 .758-.06l2.609 2.61 4.15-5.073a.5.5 0 0 1 .704-.07"/>
        </svg>
        Candlestick D1 Market Chart
      </span>

      <!-- Asset Selector -->
      <select id="chartAssetSelect" class="form-select form-select-sm" style="width: auto;" aria-label="Select Asset">
        <% assets.forEach(function(asset) { %>
          <option value="<%= asset.id %>"><%= asset.symbol %> (<%= asset.name %>)</option>
        <% }); %>
      </select>

      <!-- Exchange Selector -->
      <select id="chartExchangeSelect" class="form-select form-select-sm" style="width: auto;" aria-label="Select Exchange">
        <% exchanges.forEach(function(ex) { %>
          <option value="<%= ex.id %>"><%= ex.display_name %></option>
        <% }); %>
      </select>
    </div>

    <!-- Dynamic Timeframe Buttons from .env & Refresh -->
    <div class="d-flex align-items-center gap-2">
      <div id="chartTimeframeGroup" class="btn-group btn-group-sm" role="group" aria-label="Chart Timeframe">
        <% (chartSupportedTimeframes || [{ days: 7, label: '7D' }, { days: 30, label: '30D' }, { days: 180, label: '180D' }]).forEach(function(tf) { %>
          <button
            type="button"
            class="btn <%= tf.days === (chartDefaultDays || 7) ? 'btn-primary active' : 'btn-outline-secondary' %>"
            data-days="<%= tf.days %>"
          >
            <%= tf.label %>
          </button>
        <% }); %>
      </div>
      <button id="chartReloadBtn" type="button" class="btn btn-sm btn-outline-secondary" title="Reload Chart Data">
        ↻
      </button>
    </div>
  </div>

  <div class="card-body p-2 position-relative">
    <div id="chartLoadingIndicator" class="position-absolute top-50 start-50 translate-middle text-muted small d-none">
      <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
      <span class="ms-1">Loading candles...</span>
    </div>
    <div id="apexCandleChart" style="min-height: 350px;"></div>
  </div>
</div>
