  <!-- Admin Exchange Management & Reset DB Script -->
  <% if (locals.currentUser && locals.currentUser.role === 'ADMIN') { %>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const isDark = () => document.documentElement.getAttribute('data-bs-theme') === 'dark';

      // 1. Reset Database Handler with SweetAlert2 confirmation
      const btnReset = document.getElementById('btnNavResetDb');
      if (btnReset) {
        btnReset.addEventListener('click', async () => {
          const dark = isDark();
          const confirmResult = await Swal.fire({
            title: '⚠️ Reset Database?',
            text: 'This will truncate all tables and re-seed default demo data. This action cannot be undone!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Reset Database',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            background: dark ? '#1e293b' : '#ffffff',
            color: dark ? '#f8fafc' : '#1e293b',
          });

          if (!confirmResult.isConfirmed) return;

          Swal.fire({
            title: 'Resetting Database...',
            html: '<div class="spinner-border text-danger my-3" role="status"></div><p class="text-muted small">Re-running seeds and truncating tables...</p>',
            showConfirmButton: false,
            allowOutsideClick: false,
            background: dark ? '#1e293b' : '#ffffff',
            color: dark ? '#f8fafc' : '#1e293b',
          });

          try {
            const resp = await fetch('/reset-db', {
              method: 'POST',
              headers: { 'Accept': 'application/json' },
            });

            if (!resp.ok) {
              const errData = await resp.json().catch(() => ({}));
              throw new Error(errData.message || 'Administrator privilege required.');
            }

            await Swal.fire({
              icon: 'success',
              title: 'Database Reset Complete',
              text: 'All tables re-seeded with fresh market assets and demo alerts.',
              timer: 1800,
              showConfirmButton: false,
              background: dark ? '#1e293b' : '#ffffff',
              color: dark ? '#f8fafc' : '#1e293b',
            });
            window.location.href = '/';
          } catch (err) {
            Swal.fire({
              icon: 'error',
              title: 'Permission Denied',
              text: err.message || 'Forbidden: Administrator privilege required.',
              background: dark ? '#1e293b' : '#ffffff',
              color: dark ? '#f8fafc' : '#1e293b',
            });
          }
        });
      }

      // 2. Admin Exchanges Management Modal
      const btnExchanges = document.getElementById('btnNavExchanges');
      if (btnExchanges) {
        btnExchanges.addEventListener('click', async () => {
          const dark = isDark();

          Swal.fire({
            title: 'Loading Exchanges...',
            html: '<div class="spinner-border text-primary my-3" role="status"></div>',
            showConfirmButton: false,
            allowOutsideClick: false,
            background: dark ? '#1e293b' : '#ffffff',
            color: dark ? '#f8fafc' : '#1e293b',
          });

          try {
            const res = await fetch('/api/admin/exchanges');
            if (!res.ok) {
              const errJson = await res.json().catch(() => ({}));
              throw new Error(errJson.message || 'Forbidden: Administrator privilege required.');
            }
            const data = await res.json();
            const exchanges = data.exchanges || [];

            let rowsHtml = exchanges.map(ex => {
              const safeName = escapeHtml(ex.display_name);
              const safeCcxt = escapeHtml(ex.ccxt_id);
              const isChecked = ex.is_active ? 'checked' : '';
              return `
                <tr class="align-middle">
                  <td class="fw-semibold">
                    ${safeName}
                    <div class="text-secondary small font-monospace">${safeCcxt}</div>
                  </td>
                  <td style="width: 100px;">
                    <input type="number" class="form-control form-control-sm text-center exchange-priority" data-id="${ex.id}" value="${ex.priority_order}" min="1" max="99" style="max-width: 70px;">
                  </td>
                  <td class="text-center" style="width: 90px;">
                    <div class="form-check form-switch d-inline-block">
                      <input class="form-check-input exchange-toggle" type="checkbox" data-id="${ex.id}" ${isChecked}>
                    </div>
                  </td>
                </tr>
              `;
            }).join('');

            const modalHtml = `
              <div class="text-start">
                <p class="text-muted small mb-2">Enable or disable exchange feeds and configure priority for ticker resolution.</p>
                <div class="table-responsive border rounded mb-3" style="max-height: 260px;">
                  <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                      <tr>
                        <th>Exchange</th>
                        <th>Priority</th>
                        <th class="text-center">Active</th>
                      </tr>
                    </thead>
                    <tbody>
                      ${rowsHtml}
                    </tbody>
                  </table>
                </div>

                <div class="border rounded p-2 bg-body-tertiary">
                  <div class="fw-semibold small mb-2">➕ Register New Exchange</div>
                  <div class="row g-2">
                    <div class="col-5">
                      <input type="text" id="newCcxtId" class="form-control form-control-sm font-monospace" placeholder="ccxt_id (e.g. kraken)">
                    </div>
                    <div class="col-7">
                      <input type="text" id="newDisplayName" class="form-control form-control-sm" placeholder="Display Name (e.g. Kraken)">
                    </div>
                  </div>
                </div>
              </div>
            `;

            const result = await Swal.fire({
              title: '🏦 CCXT Exchange Manager',
              html: modalHtml,
              width: '600px',
              showCancelButton: true,
              confirmButtonText: 'Save Changes',
              cancelButtonText: 'Close',
              confirmButtonColor: '#0d6efd',
              background: dark ? '#1e293b' : '#ffffff',
              color: dark ? '#f8fafc' : '#1e293b',
              preConfirm: async () => {
                const updates = [];
                document.querySelectorAll('.exchange-priority').forEach(input => {
                  const id = input.getAttribute('data-id');
                  const priority = parseInt(input.value, 10) || 10;
                  const toggle = document.querySelector('.exchange-toggle[data-id="' + id + '"]');
                  const isActive = toggle ? toggle.checked : true;
                  updates.push(
                    fetch('/api/admin/exchanges/' + id, {
                      method: 'PUT',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ priority_order: priority, is_active: isActive }),
                    })
                  );
                });

                // Check if adding new exchange
                const newCcxt = (document.getElementById('newCcxtId')?.value || '').trim();
                const newName = (document.getElementById('newDisplayName')?.value || '').trim();
                if (newCcxt && newName) {
                  updates.push(
                    fetch('/api/admin/exchanges', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ ccxt_id: newCcxt, display_name: newName, is_active: true }),
                    })
                  );
                }

                try {
                  const resps = await Promise.all(updates);
                  for (const r of resps) {
                    if (!r.ok) {
                      const errData = await r.json().catch(() => ({}));
                      throw new Error(errData.error || 'Failed to update exchanges');
                    }
                  }
                  return true;
                } catch (err) {
                  Swal.showValidationMessage(err.message);
                  return false;
                }
              },
            });

            if (result.isConfirmed) {
              Swal.fire({
                icon: 'success',
                title: 'Exchanges Saved',
                text: 'Exchange settings and priorities have been updated.',
                timer: 1500,
                showConfirmButton: false,
                background: dark ? '#1e293b' : '#ffffff',
                color: dark ? '#f8fafc' : '#1e293b',
              }).then(() => window.location.reload());
            }
          } catch (err) {
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: err.message,
              background: dark ? '#1e293b' : '#ffffff',
              color: dark ? '#f8fafc' : '#1e293b',
            });
          }
        });
      }
    });
  </script>
  <% } %>

  <!-- Notification Preferences & Test Delivery Modal (Phase 8+ 3.3) -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btnNotifPref = document.getElementById('btnNavNotifPref');
      if (!btnNotifPref) return;

      const isDark = () => document.documentElement.getAttribute('data-bs-theme') === 'dark';

      btnNotifPref.addEventListener('click', async () => {
        const dark = isDark();

        Swal.fire({
          title: 'Loading Preferences...',
          html: '<div class="spinner-border text-warning my-3" role="status"></div>',
          showConfirmButton: false,
          allowOutsideClick: false,
          background: dark ? '#1e293b' : '#ffffff',
          color: dark ? '#f8fafc' : '#1e293b',
        });

        try {
          const resp = await fetch('/api/notifications/preferences');
          if (!resp.ok) throw new Error('Failed to load preferences');
          const data = await resp.json();
          const p = data.preferences || {};

          const modalHtml = `
            <div class="text-start">
              <p class="text-muted small mb-3">Configure default alert delivery channels, quiet hours suppression window, and test delivery targets.</p>

              <!-- Default Channel Selection -->
              <div class="mb-3">
                <label class="form-label small fw-semibold">Default Delivery Channel</label>
                <select id="prefDefaultChannel" class="form-select form-select-sm">
                  <option value="IN_APP" ${p.defaultChannel === 'IN_APP' ? 'selected' : ''}>📱 In-App (Dashboard Only)</option>
                  <option value="TELEGRAM" ${p.defaultChannel === 'TELEGRAM' ? 'selected' : ''}>✈️ Telegram Bot API</option>
                  <option value="DISCORD" ${p.defaultChannel === 'DISCORD' ? 'selected' : ''}>💬 Discord Webhook</option>
                  <option value="EMAIL" ${p.defaultChannel === 'EMAIL' ? 'selected' : ''}>✉️ Email (SMTP / Direct)</option>
                </select>
              </div>

              <!-- Channel Destination Targets (Encrypted at rest) -->
              <div class="card p-2 mb-3 bg-body-tertiary border">
                <div class="fw-semibold small mb-2 d-flex justify-content-between">
                  <span>🔒 Encrypted Destination Targets</span>
                  <span class="badge bg-secondary-subtle text-secondary border font-monospace" style="font-size: 0.65rem;">AES-256-GCM</span>
                </div>
                <div class="mb-2">
                  <label class="form-label small mb-1">Telegram Chat ID / User Handle</label>
                  <input type="text" id="prefTelegramTarget" class="form-control form-control-sm font-monospace" placeholder="@my_chat_id or 12345678" value="${escapeHtml(p.telegramTarget || '')}">
                </div>
                <div class="mb-2">
                  <label class="form-label small mb-1">Discord Webhook URL</label>
                  <input type="text" id="prefDiscordTarget" class="form-control form-control-sm font-monospace" placeholder="https://discord.com/api/webhooks/..." value="${escapeHtml(p.discordTarget || '')}">
                </div>
                <div>
                  <label class="form-label small mb-1">Notification Email</label>
                  <input type="email" id="prefEmailTarget" class="form-control form-control-sm" placeholder="trader@example.com" value="${escapeHtml(p.emailTarget || '')}">
                </div>
              </div>

              <!-- Quiet Hours Suppression -->
              <div class="card p-2 mb-3 bg-body-tertiary border">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fw-semibold small">🌙 Quiet Hours (Mute Outbound Alerts)</span>
                  <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" id="prefQuietEnabled" ${p.quietHoursEnabled ? 'checked' : ''}>
                  </div>
                </div>
                <div class="row g-2">
                  <div class="col-6">
                    <label class="form-label small text-secondary mb-1">Start Time</label>
                    <input type="time" id="prefQuietStart" class="form-control form-control-sm" value="${p.quietHoursStart || '22:00'}">
                  </div>
                  <div class="col-6">
                    <label class="form-label small text-secondary mb-1">End Time</label>
                    <input type="time" id="prefQuietEnd" class="form-control form-control-sm" value="${p.quietHoursEnd || '07:00'}">
                  </div>
                </div>
                <small class="text-secondary mt-1 d-block" style="font-size: 0.72rem;">Alerts during this window are silently captured in In-App history.</small>
              </div>

              <!-- Send Test Notification Button Section -->
              <div class="p-2 border rounded bg-body-secondary d-flex justify-content-between align-items-center">
                <div>
                  <div class="fw-semibold small">🚀 Test Notification Engine</div>
                  <div class="text-secondary" style="font-size: 0.72rem;">Dispatches a sample trigger alert right now.</div>
                </div>
                <button type="button" id="btnTriggerTestNotif" class="btn btn-warning btn-sm fw-semibold">
                  Send Test Alert
                </button>
              </div>
            </div>
          `;

          const result = await Swal.fire({
            title: '🔔 Notification Reliability Settings',
            html: modalHtml,
            width: '560px',
            showCancelButton: true,
            confirmButtonText: 'Save Preferences',
            cancelButtonText: 'Close',
            confirmButtonColor: '#0d6efd',
            background: dark ? '#1e293b' : '#ffffff',
            color: dark ? '#f8fafc' : '#1e293b',
            didOpen: () => {
              // Wire up "Send test notification" button inside modal
              const btnTest = document.getElementById('btnTriggerTestNotif');
              if (btnTest) {
                btnTest.addEventListener('click', async () => {
                  const channel = document.getElementById('prefDefaultChannel')?.value || 'IN_APP';
                  let target = '';
                  if (channel === 'TELEGRAM') target = document.getElementById('prefTelegramTarget')?.value;
                  else if (channel === 'DISCORD') target = document.getElementById('prefDiscordTarget')?.value;
                  else if (channel === 'EMAIL') target = document.getElementById('prefEmailTarget')?.value;

                  btnTest.disabled = true;
                  btnTest.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending...';

                  try {
                    const testResp = await fetch('/api/notifications/test', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ channel, target }),
                    });
                    const testResult = await testResp.json();
                    if (!testResp.ok) throw new Error(testResult.error || 'Failed to dispatch test notification');

                    Swal.showValidationMessage('');
                    Swal.fire({
                      icon: 'success',
                      title: 'Test Alert Dispatched!',
                      text: testResult.message,
                      timer: 2000,
                      showConfirmButton: false,
                      background: dark ? '#1e293b' : '#ffffff',
                      color: dark ? '#f8fafc' : '#1e293b',
                    });
                  } catch (err) {
                    Swal.fire({
                      icon: 'error',
                      title: 'Delivery Failed',
                      text: err.message,
                      background: dark ? '#1e293b' : '#ffffff',
                      color: dark ? '#f8fafc' : '#1e293b',
                    });
                  } finally {
                    btnTest.disabled = false;
                    btnTest.textContent = 'Send Test Alert';
                  }
                });
              }
            },
            preConfirm: async () => {
              const default_channel = document.getElementById('prefDefaultChannel')?.value || 'IN_APP';
              const telegram_target = document.getElementById('prefTelegramTarget')?.value || '';
              const discord_target = document.getElementById('prefDiscordTarget')?.value || '';
              const email_target = document.getElementById('prefEmailTarget')?.value || '';
              const quiet_hours_enabled = document.getElementById('prefQuietEnabled')?.checked || false;
              const quiet_hours_start = document.getElementById('prefQuietStart')?.value || '22:00';
              const quiet_hours_end = document.getElementById('prefQuietEnd')?.value || '07:00';

              try {
                const saveResp = await fetch('/api/notifications/preferences', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    default_channel,
                    telegram_target,
                    discord_target,
                    email_target,
                    quiet_hours_enabled,
                    quiet_hours_start,
                    quiet_hours_end,
                  }),
                });
                const saveResult = await saveResp.json();
                if (!saveResp.ok) throw new Error(saveResult.error || 'Failed to save preferences');
                return saveResult;
              } catch (err) {
                Swal.showValidationMessage(err.message);
                return false;
              }
            },
          });

          if (result.isConfirmed) {
            Swal.fire({
              icon: 'success',
              title: 'Preferences Saved',
              text: 'Notification channels and quiet hours updated.',
              timer: 1500,
              showConfirmButton: false,
              background: dark ? '#1e293b' : '#ffffff',
              color: dark ? '#f8fafc' : '#1e293b',
            });
          }
        } catch (err) {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: err.message,
            background: dark ? '#1e293b' : '#ffffff',
            color: dark ? '#f8fafc' : '#1e293b',
          });
        }
      });
    });
  </script>

  <!-- Personal API Tokens Management Modal Controller (Phase 8+ 3.8) -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btnApiTokens = document.getElementById('btnNavApiTokens');
      if (!btnApiTokens) return;

      const isDark = () => document.documentElement.getAttribute('data-bs-theme') === 'dark';

      const renderTokensTable = (tokens) => {
        if (!tokens || tokens.length === 0) {
          return '<p class="text-muted small my-3 text-center">No active API tokens found. Generate one below to automate alerts via REST API!</p>';
        }

        const rows = tokens.map(t => {
          const safeId = encodeURIComponent(t.id);
          const safeName = sanitizeHtml(t.name);
          const safePrefix = sanitizeHtml(t.prefix);
          const safeScopes = (t.scopes || []).map(s => `<span class="badge bg-secondary-subtle text-secondary me-1" style="font-size:0.65rem;">${sanitizeHtml(s)}</span>`).join('');
          const lastUsed = t.lastUsedAt ? new Date(t.lastUsedAt).toLocaleDateString() : '<span class="text-muted">Never</span>';
          const expires = t.expiresAt ? new Date(t.expiresAt).toLocaleDateString() : '<span class="text-success">Never</span>';

          return `
            <tr>
              <td><strong>${safeName}</strong><br><code class="small text-muted">${safePrefix}...</code></td>
              <td>${safeScopes}</td>
              <td class="small">${lastUsed}</td>
              <td class="small">${expires}</td>
              <td class="text-end">
                <button type="button" class="btn btn-outline-danger btn-sm btn-revoke-token py-0 px-2" data-id="${safeId}">Revoke</button>
              </td>
            </tr>
          `;
        }).join('');

        return `
          <div class="table-responsive border rounded mb-3" style="max-height: 220px;">
            <table class="table table-sm table-hover align-middle mb-0">
              <thead class="table-light small">
                <tr>
                  <th>Name / Prefix</th>
                  <th>Scopes</th>
                  <th>Last Used</th>
                  <th>Expires</th>
                  <th class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>${rows}</tbody>
            </table>
          </div>
        `;
      };

      btnApiTokens.addEventListener('click', async () => {
        const dark = isDark();

        Swal.fire({
          title: 'Personal API Tokens',
          html: '<div class="spinner-border text-primary my-3" role="status"></div>',
          showConfirmButton: false,
          background: dark ? '#1e293b' : '#ffffff',
          color: dark ? '#f8fafc' : '#1e293b',
        });

        try {
          const res = await fetch('/api/tokens');
          const data = await res.json();
          const tokens = data.tokens || [];

          await Swal.fire({
            title: '🔑 Personal Access Tokens',
            html: `
              <div class="text-start">
                <p class="text-muted small mb-2">Personal access tokens allow external automation, trading bots, and CLI scripts to query your alerts and prices securely via REST API.</p>
                <div id="tokensListContainer">${renderTokensTable(tokens)}</div>
                <hr>
                <h6 class="fw-bold mb-2">Generate New Token</h6>
                <div class="mb-2">
                  <label class="form-label small mb-1 fw-semibold">Token Description / Name</label>
                  <input type="text" id="newTokenName" class="form-control form-control-sm" placeholder="e.g. Python Script / TradingView Webhook" required>
                </div>
                <div class="mb-2">
                  <label class="form-label small mb-1 fw-semibold">Scopes / Permissions</label>
                  <div class="d-flex flex-wrap gap-2 small">
                    <div class="form-check">
                      <input class="form-check-input token-scope" type="checkbox" value="read:alerts" id="scReadAlerts" checked>
                      <label class="form-check-label" for="scReadAlerts">read:alerts</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input token-scope" type="checkbox" value="write:alerts" id="scWriteAlerts">
                      <label class="form-check-label" for="scWriteAlerts">write:alerts</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input token-scope" type="checkbox" value="read:markets" id="scReadMarkets" checked>
                      <label class="form-check-label" for="scReadMarkets">read:markets</label>
                    </div>
                  </div>
                </div>
                <div class="mb-2">
                  <label class="form-label small mb-1 fw-semibold">Expiry Duration</label>
                  <select id="newTokenExpiry" class="form-select form-select-sm">
                    <option value="">Never Expires</option>
                    <option value="30">30 Days</option>
                    <option value="90" selected>90 Days</option>
                    <option value="365">1 Year</option>
                  </select>
                </div>
              </div>
            `,
            width: '650px',
            showCancelButton: true,
            confirmButtonText: 'Generate Token',
            cancelButtonText: 'Close',
            confirmButtonColor: '#0d6efd',
            background: dark ? '#1e293b' : '#ffffff',
            color: dark ? '#f8fafc' : '#1e293b',
            didOpen: () => {
              // Wire up revoke buttons
              document.querySelectorAll('.btn-revoke-token').forEach(b => {
                b.addEventListener('click', async (e) => {
                  const tid = e.target.getAttribute('data-id');
                  if (!confirm('Are you sure you want to revoke this API token? Any script using it will stop working immediately.')) return;
                  await fetch(`/api/tokens/${tid}`, { method: 'DELETE' });
                  btnApiTokens.click(); // Reopen refreshed list
                });
              });
            },
            preConfirm: async () => {
              const name = document.getElementById('newTokenName')?.value?.trim();
              if (!name) {
                Swal.showValidationMessage('Please enter a descriptive token name');
                return false;
              }
              const scopes = Array.from(document.querySelectorAll('.token-scope:checked')).map(cb => cb.value);
              const expiresInDays = document.getElementById('newTokenExpiry')?.value || null;

              try {
                const resp = await fetch('/api/tokens', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ name, scopes, expiresInDays }),
                });
                if (!resp.ok) {
                  const errData = await resp.json().catch(() => ({}));
                  throw new Error(errData.error || 'Failed to create token');
                }
                return await resp.json();
              } catch (err) {
                Swal.showValidationMessage(err.message);
                return false;
              }
            }
          }).then(result => {
            if (result.isConfirmed && result.value && result.value.token) {
              const created = result.value.token;
              Swal.fire({
                icon: 'success',
                title: 'Token Generated!',
                html: `
                  <div class="text-start">
                    <p class="text-danger small fw-bold">⚠️ Copy this token now. For your security, it will never be displayed again!</p>
                    <div class="input-group mb-3">
                      <input type="text" id="generatedTokenText" class="form-control font-monospace small" value="${created.rawToken}" readonly>
                      <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText('${created.rawToken}'); this.textContent = 'Copied!';">Copy</button>
                    </div>
                    <div class="small text-muted">
                      <strong>Header format:</strong><br>
                      <code>Authorization: Bearer ${created.rawToken}</code>
                    </div>
                  </div>
                `,
                confirmButtonText: 'Done',
                background: dark ? '#1e293b' : '#ffffff',
                color: dark ? '#f8fafc' : '#1e293b',
              });
            }
          });
        } catch (fetchErr) {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: fetchErr.message || 'Failed to load tokens',
            background: dark ? '#1e293b' : '#ffffff',
            color: dark ? '#f8fafc' : '#1e293b',
          });
        }
      });
    });
  </script>

  <!-- Deep Coin Analysis & 200W SMA Modal Controller -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const isDark = () => document.documentElement.getAttribute('data-bs-theme') === 'dark';

      // Use event delegation on document so dynamically added cards/buttons also trigger
      document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.btn-deep-analysis');
        if (!btn) return;

        e.preventDefault();
        const assetId = btn.getAttribute('data-asset-id');
        const symbol = btn.getAttribute('data-asset-symbol') || 'Asset';
        const dark = isDark();

        if (typeof Swal === 'undefined') {
          console.error("SweetAlert2 (Swal) is not loaded");
          alert(`Analyzing ${symbol}... (Swal library not loaded)`);
          return;
        }

        Swal.fire({
          title: `Analyzing ${symbol}...`,
          html: '<div class="py-3"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted small">Computing 200-week SMA, technical indicators, and market sentiment...</p></div>',
          showConfirmButton: false,
          allowOutsideClick: false,
          background: dark ? '#1e293b' : '#ffffff',
          color: dark ? '#f8fafc' : '#1e293b'
        });

        try {
          const resp = await fetch(`/api/assets/${assetId}/analysis`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ exchange_id: 1 })
          });

          if (!resp.ok) {
            const errData = await resp.json().catch(() => ({}));
            throw new Error(errData.error || 'Failed to generate analysis');
          }

          const data = await resp.json();
          const rep = data.report;
          const buy = rep.buyOption || {};
          const sma200w = rep.metrics && rep.metrics.sma200wEval ? rep.metrics.sma200wEval : {};
          const tech = rep.metrics && rep.metrics.technicals ? rep.metrics.technicals : {};
          const sent = rep.metrics && rep.metrics.sentiment ? rep.metrics.sentiment : {};

          const signalColor = rep.overallSignal === 'STRONG_BUY' ? '#198754' :
                              rep.overallSignal === 'BUY' ? '#20c997' :
                              rep.overallSignal === 'NEUTRAL' ? '#ffc107' :
                              rep.overallSignal === 'SELL' ? '#fd7e14' : '#dc3545';

          let buyBannerHtml = '';
          if (buy.eligible) {
            buyBannerHtml = `
              <div class="p-3 mb-3 text-start rounded text-white" style="background: linear-gradient(135deg, #198754 0%, #157347 100%);">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="h6 mb-0">${buy.badge}</strong>
                  <span class="badge bg-light text-dark">ACTIONABLE</span>
                </div>
                <p class="small my-2 opacity-90">${buy.rationale}</p>
                <div class="row g-1 small pt-2 border-top border-white-50">
                  <div class="col-4"><strong>Entry:</strong> $${Number(buy.targetEntry || 0).toLocaleString()}</div>
                  <div class="col-4"><strong>Take-Profit:</strong> $${Number(buy.suggestedTakeProfit || 0).toLocaleString()}</div>
                  <div class="col-4"><strong>Stop-Loss:</strong> $${Number(buy.suggestedStopLoss || 0).toLocaleString()}</div>
                </div>
              </div>
            `;
          }

          Swal.fire({
            title: `<div class="d-flex align-items-center justify-content-between w-100 pe-3">
                      <span>🔍 ${symbol} Deep Analysis</span>
                      <span class="badge rounded-pill" style="background-color: ${signalColor}; font-size: 0.85rem;">${rep.overallSignal.replace('_', ' ')} (${rep.overallScore}/100)</span>
                    </div>`,
            width: '800px',
            html: `
              <div class="text-start" style="font-size: 0.9rem;">
                ${buyBannerHtml}

                <!-- Key Metrics Row -->
                <div class="row g-2 text-center mb-3">
                  <div class="col-3">
                    <div class="p-2 border rounded ${dark ? 'bg-dark' : 'bg-light'}">
                      <small class="text-muted d-block">Price</small>
                      <strong class="text-body">$${Number(rep.currentPrice || 0).toLocaleString()}</strong>
                    </div>
                  </div>
                  <div class="col-3">
                    <div class="p-2 border rounded ${dark ? 'bg-dark' : 'bg-light'}">
                      <small class="text-muted d-block">Risk</small>
                      <strong class="text-info">${rep.riskLevel}</strong>
                    </div>
                  </div>
                  <div class="col-3">
                    <div class="p-2 border rounded ${dark ? 'bg-dark' : 'bg-light'}">
                      <small class="text-muted d-block">Technicals</small>
                      <strong class="text-primary">${rep.technicalScore}/100</strong>
                    </div>
                  </div>
                  <div class="col-3">
                    <div class="p-2 border rounded ${dark ? 'bg-dark' : 'bg-light'}">
                      <small class="text-muted d-block">Sentiment</small>
                      <strong class="text-warning">${rep.sentimentScore}/100</strong>
                    </div>
                  </div>
                </div>

                <!-- Executive Summary -->
                <div class="p-2 mb-3 border rounded ${dark ? 'bg-dark' : 'bg-light'}">
                  <strong class="text-primary d-block mb-1">Executive Summary:</strong>
                  <div class="small" style="white-space: pre-line;">${rep.summaryText}</div>
                </div>

                <!-- Detail Table -->
                <div class="table-responsive small">
                  <table class="table table-sm ${dark ? 'table-dark' : ''}">
                    <tbody>
                      <tr>
                        <td><strong>200-Week SMA</strong> (Macro Floor)</td>
                        <td class="text-end fw-bold">
                          ${sma200w.sma200w 
                            ? '$' + Number(sma200w.sma200w).toLocaleString() + ' (' + (sma200w.distancePct > 0 ? '+' : '') + sma200w.distancePct + '%)' 
                            : `<span class="badge bg-secondary-subtle text-secondary" title="Requires at least 200 weekly candles">${sma200w.reason || 'Insufficient data (<200w)'}</span>`}
                        </td>
                      </tr>
                      <tr>
                        <td><strong>50-Day / 200-Day SMA</strong></td>
                        <td class="text-end">
                          ${tech.sma50 ? '$' + Number(Number(tech.sma50).toFixed(2)).toLocaleString() : '<span class="badge bg-secondary-subtle text-secondary">&lt;50d</span>'}
                          &nbsp;/&nbsp;
                          ${tech.sma200 ? '$' + Number(Number(tech.sma200).toFixed(2)).toLocaleString() : `<span class="badge bg-secondary-subtle text-secondary" title="Requires at least 200 daily candles">${(tech.reasons && tech.reasons.sma200d) || 'Insufficient data (<200d)'}</span>`}
                        </td>
                      </tr>
                      <tr>
                        <td><strong>RSI (14)</strong> / <strong>MACD</strong></td>
                        <td class="text-end">
                          RSI: <strong>${tech.rsi14 !== null ? tech.rsi14 : '<span class="text-muted">&lt;15d</span>'}</strong> | MACD: <strong>${tech.macd ? tech.macd.histogram : '<span class="text-muted">&lt;35d</span>'}</strong>
                        </td>
                      </tr>
                      <tr>
                        <td><strong>Bollinger Bands</strong> (Support / Resistance)</td>
                        <td class="text-end">
                          $${rep.supportPrice ? Number(rep.supportPrice).toLocaleString() : 'N/A'} &rarr; $${rep.resistancePrice ? Number(rep.resistancePrice).toLocaleString() : 'N/A'}
                        </td>
                      </tr>
                      <tr>
                        <td><strong>Fear & Greed Index</strong></td>
                        <td class="text-end">
                          ${sent.fearAndGreed ? sent.fearAndGreed.value + ' (' + sent.fearAndGreed.classification + ')' : '<span class="text-muted">Unavailable</span>'}
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                  <div class="d-flex gap-2">
                    <a href="/reports/${rep.id}/print" target="_blank" class="btn btn-sm btn-outline-secondary">
                      🖨️ Printable PDF View
                    </a>
                    <a href="/api/reports/${rep.id}.json" target="_blank" class="btn btn-sm btn-outline-secondary">
                      📥 JSON Export
                    </a>
                  </div>
                  ${sma200w.sma200w ? `
                    <button type="button" class="btn btn-sm btn-success" id="btnCreateBuyAlert200W">
                      🔔 Buy Alert at 200W SMA ($${Number(sma200w.sma200w).toLocaleString()})
                    </button>
                  ` : ''}
                </div>
              </div>
            `,
            showConfirmButton: false,
            showCloseButton: true,
            background: dark ? '#1e293b' : '#ffffff',
            color: dark ? '#f8fafc' : '#1e293b',
            didOpen: () => {
              const btnAlert = document.getElementById('btnCreateBuyAlert200W');
              if (btnAlert && sma200w.sma200w) {
                btnAlert.addEventListener('click', () => {
                  Swal.close();
                  // Pre-fill create alert form
                  const assetSelect = document.getElementById('asset_id');
                  const targetInput = document.getElementById('target_price');
                  const condSelect = document.getElementById('condition_type');
                  if (assetSelect) assetSelect.value = assetId;
                  if (targetInput) targetInput.value = sma200w.sma200w;
                  if (condSelect) condSelect.value = 'BELOW';
                  targetInput.scrollIntoView({ behavior: 'smooth' });
                  targetInput.focus();
                });
              }
            }
          });
        } catch (err) {
          Swal.fire({
            icon: 'error',
            title: 'Analysis Error',
            text: err.message || 'Failed to complete analysis',
            background: dark ? '#1e293b' : '#ffffff',
            color: dark ? '#f8fafc' : '#1e293b'
          });
        }
      });
    });
  </script>

  <!-- Theme Toggle Client Controller -->
  <script>
    (function() {
      const getStoredTheme = () => localStorage.getItem('theme') || 'auto';
      const setStoredTheme = (theme) => localStorage.setItem('theme', theme);

      const getPreferredTheme = () => {
        const storedTheme = getStoredTheme();
        if (storedTheme !== 'auto') {
          return storedTheme;
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const setTheme = (theme) => {
        const resolved = theme === 'auto'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : theme;
        document.documentElement.setAttribute('data-bs-theme', resolved);
        updateButtonUI(theme);
      };

      const updateButtonUI = (theme) => {
        const iconEl = document.getElementById('theme-current-icon');
        const textEl = document.getElementById('theme-current-text');
        if (!iconEl || !textEl) return;

        if (theme === 'light') {
          iconEl.textContent = '☀️';
          textEl.textContent = 'Light';
        } else if (theme === 'dark') {
          iconEl.textContent = '🌙';
          textEl.textContent = 'Dark';
        } else {
          iconEl.textContent = '🌓';
          textEl.textContent = 'Auto';
        }

        // Active state in dropdown
        document.querySelectorAll('[data-theme-value]').forEach(btn => {
          const isActive = btn.getAttribute('data-theme-value') === theme;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-pressed', isActive);
        });
      };

      // Set initial UI state
      setTheme(getStoredTheme());

      // Listen for system theme changes when set to auto
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        const storedTheme = getStoredTheme();
        if (storedTheme === 'auto') {
          setTheme('auto');
        }
      });

      // Hook click events on theme options
      document.addEventListener('DOMContentLoaded', () => {
        updateButtonUI(getStoredTheme());
        document.querySelectorAll('[data-theme-value]').forEach(toggle => {
          toggle.addEventListener('click', () => {
            const theme = toggle.getAttribute('data-theme-value');
            setStoredTheme(theme);
            setTheme(theme);
          });
        });
      });
    })();
  </script>
</body>
</html>
