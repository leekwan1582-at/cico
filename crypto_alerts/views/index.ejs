              </div>
            </div>
          `,
          allowOutsideClick: false,
          allowEscapeKey: false,
          showConfirmButton: false,
          background: isDark ? '#1e293b' : '#ffffff',
          color: isDark ? '#f8fafc' : '#1e293b',
          didOpen: () => {
            const pBar = document.getElementById('syncProgressBar');
            const pText = document.getElementById('syncStatusText');
            // Progress animation stages
            setTimeout(() => {
              if (pBar) pBar.style.width = '60%';
              if (pText) pText.textContent = 'Saving candlestick series & computing technical indicators...';
            }, 600);
            setTimeout(() => {
              if (pBar) pBar.style.width = '85%';
              if (pText) pText.textContent = 'Evaluating trigger thresholds & audit trail...';
            }, 1200);
          }
        });

        try {
          const resp = await fetch('/refresh', {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
            },
          });

          if (!resp.ok) {
            const errData = await resp.json().catch(() => ({}));
            throw new Error(errData.error || 'Server error occurred during refresh');
          }

          const data = await resp.json();
          const pBar = document.getElementById('syncProgressBar');
          const pText = document.getElementById('syncStatusText');
          const pBadge = document.getElementById('syncStageBadge');
          if (pBar) {
            pBar.style.width = '100%';
            pBar.classList.remove('bg-warning');
            pBar.classList.add('bg-success');
          }
          if (pText) pText.textContent = 'Data sync complete!';
          if (pBadge) {
            pBadge.className = 'badge bg-success text-light';
            pBadge.textContent = 'Done';
          }

          setTimeout(() => {
            Swal.fire({
              icon: 'success',
              title: 'Market Data Refreshed',
              text: 'Multi-timeframe candlestick data and alert triggers updated successfully.',
              timer: 1200,
              showConfirmButton: false,
              background: isDark ? '#1e293b' : '#ffffff',
              color: isDark ? '#f8fafc' : '#1e293b',
            }).then(() => {
              window.location.reload();
            });
          }, 400);
        } catch (err) {
          Swal.fire({
            icon: 'error',
            title: 'Refresh Failed',
            text: err.message,
            confirmButtonColor: '#0d6efd',
            background: isDark ? '#1e293b' : '#ffffff',
            color: isDark ? '#f8fafc' : '#1e293b',
