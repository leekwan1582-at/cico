  <!-- Alert Event Audit Trail SweetAlert2 Controller (Phase 8+ 3.2) -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.btn-alert-history').forEach(btn => {
        btn.addEventListener('click', async () => {
          const alertId = btn.getAttribute('data-alert-id');
          const assetSymbol = btn.getAttribute('data-asset') || 'Asset';
          const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';

          Swal.fire({
            title: `Loading Audit Trail for #${alertId}...`,
            html: '<div class="spinner-border text-info my-3" role="status"></div>',
            showConfirmButton: false,
            allowOutsideClick: false,
            background: isDark ? '#1e293b' : '#ffffff',
            color: isDark ? '#f8fafc' : '#1e293b',
          });

          try {
            const resp = await fetch(`/api/alerts/${alertId}/events`);
            if (!resp.ok) {
              const errData = await resp.json().catch(() => ({}));
              throw new Error(errData.error || 'Failed to load alert event history');
            }
            const data = await resp.json();
            const events = data.events || [];

            let timelineItems = events.map(evt => {
              const safeType = escapeHtml(evt.event_type);
              const safeMsg = escapeHtml(evt.message || 'No description');
              const timeStr = new Date(evt.created_at).toLocaleString();
              let badgeClass = 'bg-secondary';
              if (evt.event_type === 'TRIGGERED') badgeClass = 'bg-danger text-light';
              else if (evt.event_type === 'CREATED') badgeClass = 'bg-primary text-light';
              else if (evt.event_type === 'RE-ARMED') badgeClass = 'bg-warning text-dark';
              else if (evt.event_type === 'NOTIFIED') badgeClass = 'bg-success text-light';
              else if (evt.event_type === 'FAILED') badgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';

              return `
                <div class="d-flex align-items-start gap-2 py-2 border-bottom border-secondary-subtle">
                  <span class="badge ${badgeClass} mt-1" style="font-size: 0.65rem;">${safeType}</span>
                  <div class="flex-grow-1">
                    <div class="small fw-semibold text-body">${safeMsg}</div>
                    <div class="text-secondary" style="font-size: 0.72rem;">${timeStr}</div>
                  </div>
                  ${evt.price_at_event ? `<span class="badge bg-body-tertiary text-body border" style="font-size: 0.7rem;">$${Number(evt.price_at_event).toLocaleString()}</span>` : ''}
                </div>
              `;
            }).join('');

            if (!timelineItems) {
              timelineItems = '<div class="p-3 text-center text-muted small">No audit history found for this alert.</div>';
            }

            const modalHtml = `
              <div class="text-start">
                <div class="p-2 mb-2 rounded bg-body-tertiary border d-flex justify-content-between align-items-center">
                  <span class="small fw-bold">Target Pair: <strong>${escapeHtml(assetSymbol)}</strong></span>
                  <span class="badge bg-secondary-subtle text-secondary border">Alert #${alertId}</span>
                </div>
                <div style="max-height: 320px; overflow-y: auto;">
                  ${timelineItems}
                </div>
              </div>
            `;

            Swal.fire({
              title: `📜 Alert Audit Trail`,
              html: modalHtml,
              width: '520px',
              confirmButtonText: 'Close',
              confirmButtonColor: '#0d6efd',
              background: isDark ? '#1e293b' : '#ffffff',
              color: isDark ? '#f8fafc' : '#1e293b',
            });
          } catch (err) {
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: err.message,
              background: isDark ? '#1e293b' : '#ffffff',
              color: isDark ? '#f8fafc' : '#1e293b',
            });
          }
        });
      });
    });
  </script>

  <!-- Condition Type Dynamic Input Field Controller -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const condSelect = document.getElementById('condition_type');
      const labelEl = document.getElementById('targetPriceLabel');
      const prefixEl = document.getElementById('targetPricePrefix');
      const suffixEl = document.getElementById('targetPriceSuffix');
      const helpEl = document.getElementById('targetHelpText');
      const inputEl = document.getElementById('target_price');

      if (!condSelect || !labelEl) return;

      const updateConditionUI = () => {
        const val = condSelect.value;
        if (val === 'ABOVE') {
          labelEl.textContent = 'Target Price ($ USD)';
          prefixEl.classList.remove('d-none');
          prefixEl.textContent = '$';
          suffixEl.classList.add('d-none');
          inputEl.placeholder = 'e.g. 95000.00';
          helpEl.textContent = 'Alert will trigger when market close meets or exceeds this target price.';
        } else if (val === 'BELOW') {
          labelEl.textContent = 'Target Price ($ USD)';
          prefixEl.classList.remove('d-none');
          prefixEl.textContent = '$';
          suffixEl.classList.add('d-none');
          inputEl.placeholder = 'e.g. 80000.00';
          helpEl.textContent = 'Alert will trigger when market close drops to or below this target price.';
        } else if (val === 'PCT_CHANGE_24H_ABOVE') {
          labelEl.textContent = '24h Gain Target (%)';
          prefixEl.classList.remove('d-none');
          prefixEl.textContent = '+';
          suffixEl.classList.remove('d-none');
          inputEl.placeholder = 'e.g. 5.0';
          helpEl.textContent = 'Alert triggers when 24-hour return surges by at least this percentage.';
        } else if (val === 'PCT_CHANGE_24H_BELOW') {
          labelEl.textContent = '24h Loss Target (%)';
          prefixEl.classList.remove('d-none');
          prefixEl.textContent = '-';
          suffixEl.classList.remove('d-none');
          inputEl.placeholder = 'e.g. 10.0';
          helpEl.textContent = 'Alert triggers when 24-hour return drops by at least this percentage.';
        } else if (val === 'TRAILING_STOP') {
          labelEl.textContent = 'Trailing Drawdown Distance (%)';
          prefixEl.classList.add('d-none');
          suffixEl.classList.remove('d-none');
          inputEl.placeholder = 'e.g. 5.0';
          helpEl.textContent = 'Alert tracks highest peak price and triggers when price drops X% from that peak.';
        } else if (val === 'RSI_ABOVE') {
          labelEl.textContent = 'RSI (14) Overbought Level (0-100)';
          prefixEl.classList.add('d-none');
          suffixEl.classList.add('d-none');
          inputEl.placeholder = 'e.g. 70';
          helpEl.textContent = 'Alert triggers when 14-day RSI meets or exceeds this level (e.g. 70).';
        } else if (val === 'RSI_BELOW') {
          labelEl.textContent = 'RSI (14) Oversold Level (0-100)';
          prefixEl.classList.add('d-none');
          suffixEl.classList.add('d-none');
          inputEl.placeholder = 'e.g. 30';
          helpEl.textContent = 'Alert triggers when 14-day RSI drops to or below this level (e.g. 30).';
        } else if (val === 'SMA_GOLDEN_CROSS') {
          labelEl.textContent = 'Threshold (1 = Active Trigger)';
          prefixEl.classList.add('d-none');
          suffixEl.classList.add('d-none');
          inputEl.placeholder = '1';
          if (!inputEl.value) inputEl.value = '1';
          helpEl.textContent = 'Bullish signal: Triggers when the 50-day SMA crosses above the 200-day SMA.';
        } else if (val === 'SMA_DEATH_CROSS') {
          labelEl.textContent = 'Threshold (1 = Active Trigger)';
          prefixEl.classList.add('d-none');
          suffixEl.classList.add('d-none');
          inputEl.placeholder = '1';
          if (!inputEl.value) inputEl.value = '1';
          helpEl.textContent = 'Bearish signal: Triggers when the 50-day SMA crosses below the 200-day SMA.';
        } else if (val === 'VOLUME_SPIKE') {
          labelEl.textContent = 'Volume Multiplier (× 20-Day Average)';
          prefixEl.classList.add('d-none');
          suffixEl.classList.remove('d-none');
          suffixEl.textContent = '×';
          inputEl.placeholder = 'e.g. 2.0';
          helpEl.textContent = 'Triggers when daily trading volume is at least N times the 20-day average volume.';
        }
      };

      condSelect.addEventListener('change', updateConditionUI);
      updateConditionUI();
    });
  </script>

  <!-- User Profile Popup Controller -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btnProfile = document.getElementById('btnUserProfile');
      if (!btnProfile) return;

      btnProfile.addEventListener('click', async () => {
        const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';

        try {
          const res = await fetch('/profile');
          const data = await res.json();
          if (!data.success) throw new Error(data.error || 'Failed to fetch profile');

          const user = data.user;
          const memberSince = user.created_at ? new Date(user.created_at).toLocaleDateString() : 'N/A';
          const safeUsername = escapeHtml(user.username);
          const safeEmail = escapeHtml(user.email);
          const safeMemberSince = escapeHtml(memberSince);

          const modalHtml = `
            <div class="text-start">
              <div class="d-flex align-items-center gap-3 p-3 mb-3 rounded bg-body-tertiary border border-secondary-subtle">
                <span class="fs-1">👤</span>
                <div>
                  <h6 class="fw-bold m-0 text-body">${safeUsername}</h6>
                  <small class="text-secondary d-block">${safeEmail}</small>
                  <small class="text-secondary" style="font-size: 0.72rem;">Member since: ${safeMemberSince}</small>
                </div>
              </div>

              <h6 class="fw-bold mb-2 small text-secondary text-uppercase" style="letter-spacing: 0.5px;">Edit Profile Information</h6>
              <form id="formEditProfile" class="row g-2">
                <div class="col-12">
                  <label class="form-label small fw-semibold mb-1">Username</label>
                  <input type="text" id="profUsername" class="form-control form-control-sm" value="${safeUsername}" required>
                </div>
                <div class="col-12">
                  <label class="form-label small fw-semibold mb-1">Email Address</label>
                  <input type="email" id="profEmail" class="form-control form-control-sm" value="${safeEmail}" required>
                </div>

                <div class="col-12 pt-2 border-top border-secondary-subtle mt-2">
                  <small class="fw-bold text-secondary d-block mb-1">Change Password (optional)</small>
                </div>
                <div class="col-12">
                  <label class="form-label small text-secondary mb-1">Current Password</label>
                  <input type="password" id="profCurrentPass" class="form-control form-control-sm" placeholder="Required only if changing password">
                </div>
                <div class="col-12">
                  <label class="form-label small text-secondary mb-1">New Password</label>
                  <input type="password" id="profNewPass" class="form-control form-control-sm" placeholder="Minimum 6 characters">
                </div>
              </form>
            </div>
          `;

          Swal.fire({
            title: '👤 Trader Profile',
            html: modalHtml,
            icon: 'info',
            width: '500px',
            showCancelButton: true,
            confirmButtonText: 'Save Changes',
            confirmButtonColor: '#0d6efd',
            cancelButtonColor: '#6c757d',
            background: isDark ? '#1e293b' : '#ffffff',
            color: isDark ? '#f8fafc' : '#1e293b',
            preConfirm: async () => {
              const username = document.getElementById('profUsername').value.trim();
              const email = document.getElementById('profEmail').value.trim();
              const current_password = document.getElementById('profCurrentPass').value;
              const new_password = document.getElementById('profNewPass').value;

              if (!username || !email) {
                Swal.showValidationMessage('Username and Email cannot be empty');
                return false;
              }

              if (new_password && new_password.length < 6) {
                Swal.showValidationMessage('New password must be at least 6 characters');
                return false;
              }

              if (new_password && !current_password) {
                Swal.showValidationMessage('Current password is required to change password');
                return false;
              }

              try {
                const updateRes = await fetch('/profile', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    username,
                    email,
                    current_password,
                    new_password,
                  }),
                });
                const result = await updateRes.json();
                if (!updateRes.ok) {
                  throw new Error(result.error || 'Failed to update profile');
                }
                return result;
              } catch (err) {
                Swal.showValidationMessage(err.message);
                return false;
              }
            },
          }).then((result) => {
            if (result.isConfirmed) {
              Swal.fire({
                icon: 'success',
                title: 'Profile Updated!',
                text: 'Your profile has been saved.',
                timer: 1500,
                showConfirmButton: false,
              }).then(() => {
                window.location.reload();
              });
            }
          });
        } catch (err) {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: err.message,
          });
        }
      });
    });
  </script>

