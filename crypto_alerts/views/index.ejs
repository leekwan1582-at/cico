<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>

  <!-- Prevent Theme Flash (FOUC) by resolving theme immediately -->
  <script>
    (function() {
      const storedTheme = localStorage.getItem('theme') || 'auto';
      const resolvedTheme = storedTheme === 'auto'
        ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : storedTheme;
      document.documentElement.setAttribute('data-bs-theme', resolvedTheme);
    })();
  </script>

  <!-- Bootstrap 5 CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  >
  <!-- Custom Overrides -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Top Navigation Bar -->
  <%- include('partials/navbar') %>

  <!-- Main Container -->
  <main class="container-fluid px-4 py-4">

    <!-- KPI D1 Ticker Cards Strip -->
    <%- include('partials/kpi_strip') %>

    <!-- Option 1 Split-View Layout -->
    <div class="row g-4">

      <!-- LEFT COLUMN: Create / Edit Alert Panel (col-md-4) -->
      <section class="col-lg-4 col-md-5 col-sm-12">
        <div class="card shadow-sm">
          <div class="card-header bg-body-tertiary py-3 border-bottom">
            <h5 class="card-title fw-bold m-0 text-body">
              <%= editAlert ? '✏️ Edit Price Alert' : '➕ Create Price Alert' %>
            </h5>
            <small class="text-secondary">
              <%= editAlert ? 'Update threshold and conditions for alert #' + editAlert.id : 'Configure target price and trigger notification' %>
            </small>
          </div>
          <div class="card-body p-3">
            <form
              method="POST"
              action="<%= editAlert ? '/alerts/' + editAlert.id + '/update' : '/alerts' %>"
              class="needs-validation"
            >
              <!-- Authenticated User (Scoped) -->
              <input type="hidden" name="user_id" value="<%= currentUser ? currentUser.id : selectedUserId %>">
              <div class="mb-3">
                <label class="form-label fw-semibold small text-secondary">Active Trader</label>
                <div class="p-2 border rounded bg-body-tertiary d-flex align-items-center gap-2">
                  <span class="fs-6">👤</span>
                  <strong><%= currentUser ? currentUser.username : 'Default Trader' %></strong>
                  <span class="badge bg-success-subtle text-success border border-success-subtle ms-auto">Authenticated</span>
                </div>
              </div>

              <!-- Crypto Asset Dropdown -->
              <div class="mb-3">
                <label for="asset_id" class="form-label fw-semibold small">Crypto Asset</label>
                <select name="asset_id" id="asset_id" class="form-select form-select-sm" required>
                  <% for (let a of assets) { %>
                    <option
                      value="<%= a.id %>"
                      <%= (editAlert && editAlert.asset_id === a.id) ? 'selected' : '' %>
                    >
                      <%= a.symbol %> — <%= a.name %> ($<%= Number(a.last_d1_close).toLocaleString('en-US') %>)
                    </option>
                  <% } %>
                </select>
              </div>

              <!-- Exchange Selection -->
              <div class="mb-3">
                <label for="exchange_id" class="form-label fw-semibold small">Price Feed Exchange</label>
                <select name="exchange_id" id="exchange_id" class="form-select form-select-sm" required>
                  <% for (let ex of exchanges) { %>
                    <option
                      value="<%= ex.id %>"
                      <%= (editAlert && editAlert.exchange_id === ex.id) ? 'selected' : '' %>
                    >
                      <%= ex.display_name %>
                    </option>
                  <% } %>
                </select>
              </div>

              <!-- Trigger Condition Selection -->
              <div class="mb-3">
                <label for="condition_type" class="form-label fw-semibold small d-block">Condition Trigger</label>
                <select name="condition_type" id="condition_type" class="form-select form-select-sm" required>
                  <optgroup label="Static Price Target">
                    <option value="ABOVE" <%= (!editAlert || editAlert.condition_type === 'ABOVE') ? 'selected' : '' %>>
                      📈 Price ABOVE (>= $)
                    </option>
                    <option value="BELOW" <%= (editAlert && editAlert.condition_type === 'BELOW') ? 'selected' : '' %>>
                      📉 Price BELOW (<= $)
                    </option>
                  </optgroup>
                  <optgroup label="24h Percentage Return">
                    <option value="PCT_CHANGE_24H_ABOVE" <%= (editAlert && editAlert.condition_type === 'PCT_CHANGE_24H_ABOVE') ? 'selected' : '' %>>
                      🚀 24h Surge >= (+X%)
                    </option>
                    <option value="PCT_CHANGE_24H_BELOW" <%= (editAlert && editAlert.condition_type === 'PCT_CHANGE_24H_BELOW') ? 'selected' : '' %>>
                      🩸 24h Drop <= (-X%)
                    </option>
                  </optgroup>
                  <optgroup label="Risk Management & Trailing Stops">
                    <option value="TRAILING_STOP" <%= (editAlert && editAlert.condition_type === 'TRAILING_STOP') ? 'selected' : '' %>>
                      🛡️ Trailing Stop (X% drop from peak)
                    </option>
                  </optgroup>
                  <optgroup label="Technical Indicators (Phase 8+ 3.5)">
                    <option value="RSI_ABOVE" <%= (editAlert && editAlert.condition_type === 'RSI_ABOVE') ? 'selected' : '' %>>
                      ⚡ RSI (14) Overbought (>= X)
                    </option>
                    <option value="RSI_BELOW" <%= (editAlert && editAlert.condition_type === 'RSI_BELOW') ? 'selected' : '' %>>
                      ⚡ RSI (14) Oversold (<= X)
                    </option>
                    <option value="SMA_GOLDEN_CROSS" <%= (editAlert && editAlert.condition_type === 'SMA_GOLDEN_CROSS') ? 'selected' : '' %>>
                      ✨ SMA 50/200 Golden Cross (Bullish)
                    </option>
                    <option value="SMA_DEATH_CROSS" <%= (editAlert && editAlert.condition_type === 'SMA_DEATH_CROSS') ? 'selected' : '' %>>
                      💀 SMA 50/200 Death Cross (Bearish)
                    </option>
                    <option value="VOLUME_SPIKE" <%= (editAlert && editAlert.condition_type === 'VOLUME_SPIKE') ? 'selected' : '' %>>
                      📊 Volume Spike (>= N× 20d avg)
                    </option>
                  </optgroup>
                </select>
              </div>

              <!-- Target Price / Percentage Input -->
              <div class="mb-3">
                <label for="target_price" id="targetPriceLabel" class="form-label fw-semibold small">Target Price ($ USD)</label>
                <div class="input-group input-group-sm">
                  <span class="input-group-text" id="targetPricePrefix">$</span>
                  <input
                    type="number"
                    step="0.01"
                    min="0.01"
                    name="target_price"
                    id="target_price"
                    class="form-control"
                    placeholder="e.g. 95000.00"
                    value="<%= editAlert ? Number(editAlert.target_price) : '' %>"
                    required
                  >
                  <span class="input-group-text d-none" id="targetPriceSuffix">%</span>
                </div>
                <small class="text-secondary d-block mt-1" id="targetHelpText" style="font-size: 0.72rem;">
                  Alert will trigger when market close meets or exceeds this target.
                </small>
              </div>

              <!-- Notification Channel & Target -->
              <div class="mb-4 p-2 rounded bg-body-tertiary border">
                <label class="form-label fw-semibold small mb-1 d-flex align-items-center justify-content-between">
                  <span>🔔 Alert Dispatch Channel</span>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 10px;">Instant Webhook</span>
                </label>
                <div class="row g-2">
                  <div class="col-sm-5">
                    <select name="notification_channel" id="notification_channel" class="form-select form-select-sm">
                      <option value="IN_APP" <%= (!editAlert || editAlert.notification_channel === 'IN_APP') ? 'selected' : '' %>>📱 In-App (Dashboard)</option>
                      <option value="TELEGRAM" <%= (editAlert && editAlert.notification_channel === 'TELEGRAM') ? 'selected' : '' %>>✈️ Telegram</option>
                      <option value="DISCORD" <%= (editAlert && editAlert.notification_channel === 'DISCORD') ? 'selected' : '' %>>💬 Discord Webhook</option>
                      <option value="EMAIL" <%= (editAlert && editAlert.notification_channel === 'EMAIL') ? 'selected' : '' %>>✉️ Email</option>
                    </select>
                  </div>
                  <div class="col-sm-7">
                    <input
                      type="text"
                      name="recipient_target"
                      id="recipient_target"
                      class="form-control form-control-sm"
                      placeholder="e.g. @chat_id, webhook URL or email"
                      value="<%= editAlert ? (editAlert.recipient_target || '') : '' %>"
                    >
                  </div>
                </div>
                <small class="text-secondary d-block mt-1" style="font-size: 11px;">
                  Dispatches immediately when price condition is triggered.
                </small>
              </div>

              <!-- Form Action Buttons -->
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1 fw-semibold">
                  <%= editAlert ? '💾 Update Alert' : '➕ Save Alert' %>
                </button>
                <% if (editAlert) { %>
                  <a href="/" class="btn btn-outline-secondary btn-sm">Cancel</a>
                <% } %>
              </div>
            </form>
          </div>
        </div>
      </section>

      <!-- RIGHT COLUMN: Watchlist Table, Chart & Filter Bar (col-md-8) -->
      <section class="col-lg-8 col-md-7 col-sm-12">

        <div class="card shadow-sm mb-4">

          <!-- Filter Toolbar Header -->
          <div class="card-header bg-body-tertiary py-3 border-bottom">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
              <div>
                <h5 class="card-title fw-bold m-0 text-body">📋 Price Alerts Watchlist</h5>
                <small class="text-secondary"><%= alerts.length %> alerts matching current criteria</small>
              </div>

              <!-- Multi-Criteria Filter Bar (GET /) -->
              <form method="GET" action="/" class="d-flex align-items-center gap-2 flex-wrap">
                <!-- User Filter -->
                <select name="user_id" class="form-select form-select-sm" style="width: auto;">
                  <option value="">Filter by User (All)</option>
                  <% for (let u of users) { %>
                    <option value="<%= u.id %>" <%= String(selectedUserId) === String(u.id) ? 'selected' : '' %>>
                      <%= u.username %>
                    </option>
                  <% } %>
                </select>

                <!-- Status Filter -->
                <select name="status" class="form-select form-select-sm" style="width: auto;">
                  <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All Statuses</option>
                  <option value="active" <%= selectedStatus === 'active' ? 'selected' : '' %>>🟢 Active</option>
                  <option value="triggered" <%= selectedStatus === 'triggered' ? 'selected' : '' %>>🔴 Triggered</option>
                </select>

                <button type="submit" class="btn btn-outline-primary btn-sm">Filter</button>
                <a href="/" class="btn btn-outline-secondary btn-sm">Reset</a>

                <!-- Data Export Dropdown (CSV / JSON) (Phase 8+ 3.8) -->
                <div class="dropdown">
                  <button class="btn btn-outline-success btn-sm dropdown-toggle d-flex align-items-center gap-1" type="button" id="exportMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <span>📥</span> Export
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="exportMenuDropdown">
                    <li>
                      <a class="dropdown-item d-flex align-items-center gap-2" href="/api/alerts.csv<%= selectedStatus ? '?status=' + selectedStatus : '' %>">
                        <span>📊</span> Download CSV (.csv)
                      </a>
                    </li>
                    <li>
                      <a class="dropdown-item d-flex align-items-center gap-2" href="/api/alerts.json<%= selectedStatus ? '?status=' + selectedStatus : '' %>" target="_blank">
                        <span>📦</span> View JSON (.json)
                      </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <a class="dropdown-item d-flex align-items-center gap-2 text-primary" href="/api/docs" target="_blank">
                        <span>📖</span> REST API Docs
                      </a>
                    </li>
                  </ul>
                </div>
              </form>
            </div>
          </div>

          <!-- Alerts Responsive Table -->
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="ps-3">ID</th>
                  <th scope="col">User</th>
                  <th scope="col">Asset</th>
                  <th scope="col">Exchange</th>
                  <th scope="col">Condition</th>
                  <th scope="col">Target ($)</th>
                  <th scope="col">Channel</th>
                  <th scope="col">Status</th>
                  <th scope="col" class="text-end pe-3">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (alerts.length === 0) { %>
                  <tr>
                    <td colspan="9" class="text-center py-4 text-muted">
                      No price alerts found matching the selected filters. Use the left panel to create one!
                    </td>
                  </tr>
                <% } else { %>
                  <% for (let alert of alerts) { %>
                    <tr class="<%= alert.is_triggered ? 'table-danger-subtle' : '' %>" data-alert-id="<%= alert.id %>">
                      <td class="ps-3 fw-bold text-secondary">#<%= alert.id %></td>
                      <td>
                        <span class="fw-semibold"><%= alert.username %></span>
                      </td>
                      <td>
                        <span class="badge bg-secondary-subtle text-secondary border">
                          <%= alert.asset_symbol %>
                        </span>
                      </td>
                      <td><small class="text-muted"><%= alert.exchange_name %></small></td>
                      <td>
                        <% if (alert.condition_type === 'ABOVE') { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle">
                            >= ABOVE
                          </span>
                        <% } else if (alert.condition_type === 'BELOW') { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            <= BELOW
                          </span>
                        <% } else if (alert.condition_type === 'PCT_CHANGE_24H_ABOVE') { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle">
                            🚀 24h Surge
                          </span>
                        <% } else if (alert.condition_type === 'PCT_CHANGE_24H_BELOW') { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            🩸 24h Drop
                          </span>
                        <% } else if (alert.condition_type === 'TRAILING_STOP') { %>
                          <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                            🛡️ Trailing Stop
                          </span>
                        <% } else if (alert.condition_type === 'RSI_ABOVE') { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            ⚡ RSI >= <%= Number(alert.target_price).toFixed(0) %>
                          </span>
                        <% } else if (alert.condition_type === 'RSI_BELOW') { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle">
                            ⚡ RSI <= <%= Number(alert.target_price).toFixed(0) %>
                          </span>
                        <% } else if (alert.condition_type === 'SMA_GOLDEN_CROSS') { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle">
                            ✨ SMA Golden Cross
                          </span>
                        <% } else if (alert.condition_type === 'SMA_DEATH_CROSS') { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            💀 SMA Death Cross
                          </span>
                        <% } else if (alert.condition_type === 'VOLUME_SPIKE') { %>
                          <span class="badge bg-info-subtle text-info border border-info-subtle">
                            📊 Vol Spike >= <%= Number(alert.target_price).toFixed(1) %>x
                          </span>
                        <% } else { %>
                          <span class="badge bg-secondary-subtle text-secondary border">
                            <%= alert.condition_type %>
                          </span>
                        <% } %>
                      </td>
                      <td class="fw-bold text-body">
                        <% if (alert.condition_type.startsWith('PCT_CHANGE_24H') || alert.condition_type === 'TRAILING_STOP') { %>
                          <%= alert.condition_type === 'PCT_CHANGE_24H_BELOW' ? '-' : '+' %><%= Number(alert.target_price).toFixed(2) %>%
                          <% if (alert.condition_type === 'TRAILING_STOP' && alert.peak_price) { %>
                            <small class="text-secondary d-block" style="font-size: 0.68rem;">Peak: $<%= Number(alert.peak_price).toLocaleString() %></small>
                          <% } %>
                        <% } else if (alert.condition_type.startsWith('RSI_')) { %>
                          RSI <%= Number(alert.target_price).toFixed(0) %>
                        <% } else if (alert.condition_type === 'VOLUME_SPIKE') { %>
                          <%= Number(alert.target_price).toFixed(1) %>× Avg
                        <% } else if (alert.condition_type.startsWith('SMA_')) { %>
                          SMA 50/200 Cross
                        <% } else { %>
                          $<%= Number(alert.target_price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        <% } %>
                      </td>
                      <td>
                        <% if (alert.notification_channel === 'TELEGRAM') { %>
                          <span class="badge bg-info-subtle text-info border border-info-subtle" title="<%= alert.recipient_target || '' %>">✈️ TG</span>
                        <% } else if (alert.notification_channel === 'DISCORD') { %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle" title="<%= alert.recipient_target || '' %>">💬 Discord</span>
                        <% } else if (alert.notification_channel === 'EMAIL') { %>
                          <span class="badge bg-warning-subtle text-light border border-warning-subtle" title="<%= alert.recipient_target || '' %>">✉️ Email</span>
                        <% } else { %>
                          <span class="badge bg-secondary-subtle text-secondary border">📱 App</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (alert.is_triggered) { %>
                          <span class="badge badge-triggered alert-status-badge px-2 py-1">🔴 TRIGGERED</span>
                          <% if (alert.triggered_at) { %>
                            <div class="text-muted" style="font-size: 10px;"><%= new Date(alert.triggered_at).toLocaleTimeString() %></div>
                          <% } %>
                        <% } else { %>
                          <span class="badge badge-active alert-status-badge px-2 py-1">🟢 ACTIVE</span>
                        <% } %>
                      </td>
                      <td class="text-end pe-3">
                        <div class="d-inline-flex gap-1">
                          <!-- History Audit Button (Phase 8+ 3.2) -->
                          <button
                            type="button"
                            class="btn btn-outline-info btn-sm py-0 px-2 btn-alert-history"
                            data-alert-id="<%= alert.id %>"
                            data-asset="<%= alert.asset_symbol %>"
                            title="View Alert Audit History"
                          >
                            📜
                          </button>

                          <!-- Edit Button -->
                          <a
                            href="/?edit_id=<%= alert.id %>&user_id=<%= selectedUserId %>&status=<%= selectedStatus %>"
                            class="btn btn-outline-primary btn-sm py-0 px-2"
                            title="Edit Alert"
                          >
                            Edit
                          </a>

                          <!-- Delete Button Form -->
                          <form
                            action="/alerts/<%= alert.id %>/delete"
                            method="POST"
                            class="d-inline m-0"
                            onsubmit="return confirm('Are you sure you want to delete Alert #<%= alert.id %>?');"
                          >
                            <button
                              type="submit"
                              class="btn btn-outline-danger btn-sm py-0 px-2"
                              title="Delete Alert"
                            >
                              Delete
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% } %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Candlestick D1 Market Chart (ApexCharts.js) -->
        <%- include('partials/price_chart') %>

        <!-- Recent Audit Trail & Timeline (Phase 8+ 3.2 - Solves C1 / C9 visibility) -->
        <div class="card shadow-sm mt-4">
          <div class="card-header bg-body-tertiary py-3 d-flex justify-content-between align-items-center">
            <h6 class="card-title fw-bold m-0 text-body d-flex align-items-center gap-2">
              <span>📜</span>
              <span>Recent Alert Activity &amp; Audit Trail</span>
            </h6>
            <span class="badge bg-secondary-subtle text-secondary border small">Real-Time Events</span>
          </div>
          <div class="card-body p-0">
            <% if (!recentEvents || recentEvents.length === 0) { %>
              <div class="p-3 text-center text-muted small">
                No alert lifecycle events recorded yet. Events appear when alerts are created, updated, or triggered.
              </div>
            <% } else { %>
              <div class="list-group list-group-flush" style="max-height: 280px; overflow-y: auto;">
                <% for (const evt of recentEvents) { %>
                  <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-3">
                    <div class="d-flex align-items-center gap-2">
                      <% if (evt.event_type === 'TRIGGERED') { %>
                        <span class="badge bg-danger text-light px-2 py-1">🎯 TRIGGERED</span>
                      <% } else if (evt.event_type === 'CREATED') { %>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">➕ CREATED</span>
                      <% } else if (evt.event_type === 'RE-ARMED') { %>
                        <span class="badge bg-warning-subtle text-light border border-warning-subtle px-2 py-1">🔄 RE-ARMED</span>
                      <% } else if (evt.event_type === 'NOTIFIED') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">📨 NOTIFIED</span>
                      <% } else if (evt.event_type === 'FAILED') { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">⚠️ FAILED</span>
                      <% } %>
                      <div>
                        <strong class="text-body small"><%= evt.asset_symbol %></strong>
                        <span class="text-secondary small ms-1">(#<%= evt.alert_id %>)</span>
                        <div class="text-secondary" style="font-size: 0.75rem;"><%= evt.message || '' %></div>
                      </div>
                    </div>
                    <div class="text-end text-secondary small" style="font-size: 0.72rem;">
                      <div><%= new Date(evt.created_at).toLocaleDateString() %></div>
                      <div><%= new Date(evt.created_at).toLocaleTimeString() %></div>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>

      </section>

    </div>
  </main>

  <!-- Bootstrap 5 Bundle JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"
  ></script>

  <!-- ApexCharts 8.8.1 CDN -->
  <script src="https://cdn.jsdelivr.net/npm/apexcharts@8.8.1/dist/apexcharts.min.js"></script>
  <!-- Client-Side Chart Script -->
  <script src="/js/chart.js"></script>
  <!-- Real-Time SSE Dashboard Controller (Phase 8+ 3.7) -->
  <script src="/js/realtime.js"></script>

  <!-- SweetAlert2 11 CDN -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- Global HTML Sanitization Helper for Dynamic Modals & Alerts -->
  <script>
    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }
  </script>

  <!-- Refresh D1 Progress Popup Controller -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const refreshForm = document.getElementById('refreshD1Form');
      const btnRefresh = document.getElementById('btnRefreshD1');
      if (!refreshForm || !btnRefresh) return;

      refreshForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';

        // Display animated progress popup with SweetAlert2
        Swal.fire({
          title: 'Syncing Market Data...',
          html: `
            <div class="p-3 text-start">
              <div class="mb-3 d-flex align-items-center justify-content-between">
                <span class="small fw-semibold text-body" id="syncStatusText">Connecting to exchange price feeds...</span>
                <span class="badge bg-warning text-dark" id="syncStageBadge">Syncing</span>
              </div>
              <div class="progress mb-3" style="height: 10px;">
                <div id="syncProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-warning" role="progressbar" style="width: 25%;"></div>
              </div>
              <div class="small text-muted" id="syncDetails">
                • Probing CCXT exchanges (OKX, Binance)<br>
                • Populating multi-timeframe candles (1h, 4h, 1d, 1w)<br>
