  <!-- Watchlist Management Modal Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const openWatchlistHandler = async () => {
        const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        try {
          const [assetsResp, catalogResp] = await Promise.all([
            fetch('/assets?format=json'),
            fetch('/api/markets/catalog'),
          ]);
          const data = await assetsResp.json();
          const catalogData = await catalogResp.json();
          const assetsList = data.assets || [];
          const fullCatalog = catalogData.catalog || [];

          let tableRows = assetsList.map(a => {
            const safeSym = escapeHtml(a.symbol);
            const safeNm = escapeHtml(a.name);
            const safeAlerts = Number(a.alert_count) || 0;
            const safeId = encodeURIComponent(a.id);
            const isPinned = Boolean(a.is_pinned);
            const holdingQty = a.holding_qty !== null && a.holding_qty !== undefined ? a.holding_qty : '';
            const avgCost = a.avg_cost !== null && a.avg_cost !== undefined ? a.avg_cost : '';
            const formattedClose = Number(a.last_d1_close).toLocaleString('en-US', {
              minimumFractionDigits: 2,
              maximumFractionDigits: Number(a.last_d1_close) < 1 ? 4 : 2,
            });

            return `
            <tr data-asset-id="${safeId}">
              <td class="text-center">
                <button type="button" class="btn btn-sm btn-link p-0 btn-toggle-pin text-decoration-none ${isPinned ? 'text-warning' : 'text-secondary'}" data-id="${safeId}" data-pinned="${isPinned}" title="${isPinned ? 'Unpin' : 'Pin Favourite'}">
                  ${isPinned ? '★' : '☆'}
                </button>
              </td>
              <td>
                <span class="fw-bold">${safeSym}</span>
                <small class="text-secondary d-block" style="font-size: 0.72rem;">${safeNm}</small>
              </td>
              <td>$${formattedClose}</td>
              <td style="min-width: 140px;">
                <div class="input-group input-group-sm">
                  <input type="number" step="any" min="0" class="form-control form-control-sm input-holding-qty" placeholder="Qty" value="${holdingQty}" data-id="${safeId}" title="Holding Quantity" style="font-size: 0.75rem;">
                  <input type="number" step="any" min="0" class="form-control form-control-sm input-avg-cost" placeholder="Avg $" value="${avgCost}" data-id="${safeId}" title="Average Cost ($)" style="font-size: 0.75rem;">
                  <button type="button" class="btn btn-outline-success btn-save-portfolio py-0 px-1" data-id="${safeId}" title="Save Holdings">✓</button>
                </div>
              </td>
              <td><span class="badge bg-secondary-subtle text-secondary">${safeAlerts} alerts</span></td>
              <td class="text-end">
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 btn-move-up" data-id="${safeId}" title="Move Up">↑</button>
                  <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 btn-move-down" data-id="${safeId}" title="Move Down">↓</button>
                  <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 btn-delete-asset" data-id="${safeId}" data-symbol="${safeSym}" data-alerts="${safeAlerts}" title="Delete Pair">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          `;
          }).join('');

          const modalHtml = `
            <div class="text-start">
              <!-- Active Watchlist Pairs (Top Section) -->
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold m-0"><i class="bi bi-star-fill text-warning"></i> Curate Watchlist & Portfolio (${assetsList.length})</h6>
                <span class="badge bg-secondary-subtle text-secondary border">Custom Order & Pin</span>
              </div>
              <div class="table-responsive border rounded mb-3" style="max-height: 250px; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle mb-0" id="watchlistSortTable">
                  <thead class="table-light small">
                    <tr>
                      <th class="text-center" style="width: 35px;">Pin</th>
                      <th>Asset</th>
                      <th>D1 Close</th>
                      <th>Holdings (Qty / Avg $)</th>
                      <th>Alerts</th>
                      <th class="text-end" style="width: 120px;">Order / Delete</th>
                    </tr>
                  </thead>
                  <tbody>
                    ${tableRows || '<tr><td colspan="6" class="text-center text-muted py-3">No assets currently on watchlist.</td></tr>'}
                  </tbody>
                </table>
              </div>

              <!-- Pair Screener & Lookup Information (Bottom Section) -->
              <div class="card p-3 ${isDark ? 'bg-dark' : 'bg-light'} border border-secondary-subtle shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="fw-bold m-0"><i class="bi bi-search"></i> Pair Screener & Lookup</h6>
                  <span class="badge bg-primary-subtle text-primary border">${fullCatalog.length} Pairs Available</span>
                </div>
                
                <div class="input-group input-group-sm mb-2">
                  <span class="input-group-text bg-body-secondary border-secondary-subtle">🔍</span>
                  <input type="text" id="screenerSearchInput" class="form-control" placeholder="Search pair or coin (e.g. XRP, Doge, Solana, AI)..." autocomplete="off">
                </div>

                <!-- Screener Live Table Container -->
                <div id="screenerResultsContainer" class="border rounded bg-body-tertiary mb-3 p-1" style="max-height: 150px; overflow-y: auto;">
                  <div class="text-center text-secondary small py-3" id="screenerPrompt">
                    Type to search or browse top verified cryptocurrency pairs below.
                  </div>
                </div>

                <!-- Selected / Manual Input Form -->
                <h6 class="fw-bold mb-2 small text-secondary text-uppercase" style="letter-spacing: 0.5px;">Add to Watchlist</h6>
                <form id="formAddAsset" class="row g-2">
                  <div class="col-md-5">
                    <label class="form-label small text-secondary m-0">Symbol (e.g. XRP/USDT)</label>
                    <input type="text" name="symbol" id="newAssetSymbol" class="form-control form-control-sm text-uppercase" placeholder="XRP/USDT" required pattern="^[A-Za-z0-9]{2,10}/[A-Za-z0-9]{2,10}$">
                  </div>
                  <div class="col-md-5">
                    <label class="form-label small text-secondary m-0">Asset Name (e.g. Ripple)</label>
                    <input type="text" name="name" id="newAssetName" class="form-control form-control-sm" placeholder="Ripple" required>
                  </div>
                  <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Add</button>
                  </div>
                </form>
              </div>
            </div>
          `;

          Swal.fire({
            title: '🪙 Watchlist & Screener Management',
            html: modalHtml,
            icon: 'info',
            width: '820px',
            showConfirmButton: true,
            confirmButtonText: 'Done',
            confirmButtonColor: '#0d6efd',
            background: isDark ? '#1e293b' : '#ffffff',
            color: isDark ? '#f8fafc' : '#1e293b',
            didClose: () => {
              // Refresh page on close if user modified order/holdings
              if (window.hasModifiedWatchlist) {
                window.location.reload();
              }
            },
            didOpen: () => {
              const searchInput = document.getElementById('screenerSearchInput');
              const resultsContainer = document.getElementById('screenerResultsContainer');
              const symbolInput = document.getElementById('newAssetSymbol');
              const nameInput = document.getElementById('newAssetName');

              // Function to render filtered catalog items in Screener style
              const renderScreenerList = (items) => {
                if (!items || items.length === 0) {
                  resultsContainer.innerHTML = '<div class="text-center text-muted small py-2">No matching cryptocurrency pairs found.</div>';
                  return;
                }

                const listHtml = items.map(c => {
                  const alreadyAdded = c.is_on_watchlist;
                  const safeSym = escapeHtml(c.symbol);
                  const safeNm = escapeHtml(c.name);
                  const safeCat = escapeHtml(c.category);
                  const safeIcon = escapeHtml(c.icon || '◈');

                  return `
                    <div class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom border-secondary-subtle screener-item ${alreadyAdded ? 'opacity-75' : ''}">
                      <div class="d-flex align-items-center gap-2">
                        <span class="fs-6">${safeIcon}</span>
                        <div>
                          <strong class="text-body">${safeSym}</strong>
                          <span class="badge bg-secondary-subtle text-secondary ms-1 py-0 px-1" style="font-size: 0.68rem;">${safeCat}</span>
                          <small class="d-block text-secondary" style="font-size: 0.72rem;">${safeNm}</small>
                        </div>
                      </div>
                      <div class="d-flex align-items-center gap-1">
                        ${alreadyAdded 
                          ? '<span class="badge bg-success-subtle text-success border border-success-subtle small py-1 px-2"><i class="bi bi-check2"></i> In Watchlist</span>' 
                          : `<button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-pick-pair" data-symbol="${safeSym}" data-name="${safeNm}" title="Fill into form">Pick</button>
                             <button type="button" class="btn btn-sm btn-primary py-0 px-2 btn-quick-add" data-symbol="${safeSym}" data-name="${safeNm}" title="Add immediately">+ Add</button>`
                        }
                      </div>
                    </div>
                  `;
                }).join('');

                resultsContainer.innerHTML = listHtml;

                // Bind Pick buttons
                resultsContainer.querySelectorAll('.btn-pick-pair').forEach(btn => {
                  btn.addEventListener('click', () => {
                    symbolInput.value = btn.getAttribute('data-symbol');
                    nameInput.value = btn.getAttribute('data-name');
                    symbolInput.focus();
                  });
                });

                // Bind Quick Add buttons
                resultsContainer.querySelectorAll('.btn-quick-add').forEach(btn => {
                  btn.addEventListener('click', async () => {
                    const sym = btn.getAttribute('data-symbol');
                    const nm = btn.getAttribute('data-name');
                    await submitAddAsset(sym, nm);
                  });
                });
              };

              // Initial render with first 10 items
              renderScreenerList(fullCatalog.slice(0, 10));

              // Search input filter listener
              if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                  const q = e.target.value.trim().toLowerCase();
                  if (!q) {
                    renderScreenerList(fullCatalog.slice(0, 10));
                    return;
                  }
                  const filtered = fullCatalog.filter(c => 
                    c.symbol.toLowerCase().includes(q) || 
                    c.name.toLowerCase().includes(q) ||
                    c.base.toLowerCase().includes(q) ||
                    (c.category && c.category.toLowerCase().includes(q))
                  );
                  renderScreenerList(filtered);
                });
              }

              // Reusable submission helper
              const submitAddAsset = async (sym, nm) => {
                try {
                  const addResp = await fetch('/assets', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json',
                      'Accept': 'application/json',
                    },
                    body: JSON.stringify({ symbol: sym, name: nm }),
                  });
                  const addResult = await addResp.json();
                  if (!addResp.ok) {
                    throw new Error(addResult.message || (typeof addResult === 'string' ? addResult : 'Failed to add asset'));
                  }
                  Swal.fire({
                    icon: 'success',
                    title: 'Pair Added!',
                    text: addResult.message,
                    timer: 1500,
                    showConfirmButton: false,
                  }).then(() => {
                    window.location.href = '/?asset_added=' + encodeURIComponent(sym);
                  });
                } catch (addErr) {
                  Swal.showValidationMessage(addErr.message);
                }
              };

              // Bind Add Asset form submission
              const formAdd = document.getElementById('formAddAsset');
              if (formAdd) {
                formAdd.addEventListener('submit', async (e) => {
                  e.preventDefault();
                  const sym = symbolInput.value;
                  const nm = nameInput.value;
                  await submitAddAsset(sym, nm);
                });
              }

              // Helper to save entire list order & pin status
              const persistWatchlistOrder = async () => {
                window.hasModifiedWatchlist = true;
                const rows = Array.from(document.querySelectorAll('#watchlistSortTable tbody tr[data-asset-id]'));
                const items = rows.map((tr, idx) => {
                  const aid = tr.getAttribute('data-asset-id');
                  const pinBtn = tr.querySelector('.btn-toggle-pin');
                  const isPinned = pinBtn && pinBtn.getAttribute('data-pinned') === 'true';
                  return {
                    assetId: aid,
                    sortOrder: idx + 1,
                    isPinned: Boolean(isPinned),
                  };
                });

                try {
                  const resp = await fetch('/api/watchlist/reorder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ items }),
                  });
                  if (!resp.ok) {
                    const errJson = await resp.json();
                    throw new Error(errJson.error || 'Failed to reorder watchlist');
                  }
                } catch (e) {
                  console.error('Watchlist reorder error:', e);
                }
              };

              // Bind Pin Toggle buttons
              document.querySelectorAll('.btn-toggle-pin').forEach(btn => {
                btn.addEventListener('click', async () => {
                  const currentPinned = btn.getAttribute('data-pinned') === 'true';
                  const nextPinned = !currentPinned;
                  btn.setAttribute('data-pinned', String(nextPinned));
                  btn.innerHTML = nextPinned ? '★' : '☆';
                  btn.classList.toggle('text-warning', nextPinned);
                  btn.classList.toggle('text-secondary', !nextPinned);
                  await persistWatchlistOrder();
                });
              });

              // Bind Move Up / Move Down buttons
              document.querySelectorAll('.btn-move-up').forEach(btn => {
                btn.addEventListener('click', async () => {
                  const tr = btn.closest('tr');
                  if (tr && tr.previousElementSibling) {
                    tr.parentNode.insertBefore(tr, tr.previousElementSibling);
                    await persistWatchlistOrder();
                  }
                });
              });

              document.querySelectorAll('.btn-move-down').forEach(btn => {
                btn.addEventListener('click', async () => {
                  const tr = btn.closest('tr');
                  if (tr && tr.nextElementSibling) {
                    tr.parentNode.insertBefore(tr.nextElementSibling, tr);
                    await persistWatchlistOrder();
                  }
                });
              });

              // Bind Portfolio Holdings Save buttons
              document.querySelectorAll('.btn-save-portfolio').forEach(btn => {
                btn.addEventListener('click', async () => {
                  const assetId = btn.getAttribute('data-id');
                  const tr = btn.closest('tr');
                  const qtyInput = tr.querySelector('.input-holding-qty');
                  const costInput = tr.querySelector('.input-avg-cost');

                  const holding_qty = qtyInput ? qtyInput.value.trim() : '';
                  const avg_cost = costInput ? costInput.value.trim() : '';

                  try {
                    window.hasModifiedWatchlist = true;
                    const portResp = await fetch(`/api/watchlist/${assetId}/portfolio`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                      body: JSON.stringify({ holding_qty, avg_cost }),
                    });
                    const portData = await portResp.json();
                    if (!portResp.ok) throw new Error(portData.error || 'Failed to save portfolio holdings');

                    btn.classList.remove('btn-outline-success');
                    btn.classList.add('btn-success');
                    setTimeout(() => {
                      btn.classList.remove('btn-success');
                      btn.classList.add('btn-outline-success');
                    }, 1200);
                  } catch (portErr) {
                    Swal.showValidationMessage(portErr.message);
                  }
                });
              });

              // Bind Delete buttons
              document.querySelectorAll('.btn-delete-asset').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                  const assetId = btn.getAttribute('data-id');
                  const assetSym = btn.getAttribute('data-symbol');
                  const alertCount = btn.getAttribute('data-alerts');

                  const confirmMsg = Number(alertCount) > 0 
                    ? `Deleting ${assetSym} will also remove ${alertCount} linked alert(s)! Proceed?`
                    : `Remove ${assetSym} from watchlist?`;

                  const confirmResult = await Swal.fire({
                    title: `Delete ${assetSym}?`,
                    text: confirmMsg,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Delete',
                    background: isDark ? '#1e293b' : '#ffffff',
                    color: isDark ? '#f8fafc' : '#1e293b',
                  });

                  if (confirmResult.isConfirmed) {
                    try {
                      const delResp = await fetch(`/assets/${assetId}/delete`, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                      });
                      const delData = await delResp.json();
                      if (!delResp.ok) throw new Error(delData.message || 'Delete failed');

                      Swal.fire({
                        icon: 'success',
                        title: 'Deleted',
                        text: delData.message,
                        timer: 1500,
                        showConfirmButton: false,
                      }).then(() => {
                        window.location.href = '/?asset_deleted=' + encodeURIComponent(assetSym);
                      });
                    } catch (delErr) {
                      Swal.fire({
                        icon: 'error',
                        title: 'Delete Failed',
                        text: delErr.message,
                      });
                    }
                  }
                });
              });
            }
          });
        } catch (err) {
          Swal.fire({
            title: 'Watchlist Error',
            text: err.message,
            icon: 'error',
            confirmButtonText: 'Close',
          });
        }
      };

      const btnOpenWatchlist = document.getElementById('btnOpenWatchlistModal');
      const btnNavWatchlist = document.getElementById('btnNavWatchlist');
      if (btnOpenWatchlist) btnOpenWatchlist.addEventListener('click', openWatchlistHandler);
      if (btnNavWatchlist) btnNavWatchlist.addEventListener('click', openWatchlistHandler);
    });
  </script>

