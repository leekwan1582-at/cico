<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Crypto Daily Alerts</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    crossorigin="anonymous"
  >
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--bs-body-bg);
    }
    .auth-card {
      max-width: 420px;
      width: 100%;
      padding: 2rem;
      border-radius: 1rem;
    }
  </style>
</head>
<body>
  <div class="auth-card card shadow-lg border border-secondary-subtle">
    <div class="text-center mb-4">
      <div class="d-inline-flex align-items-center gap-2 mb-2">
        <span class="badge bg-warning text-dark fs-6 px-2 py-1">D1</span>
        <h4 class="fw-bold m-0 text-body">CryptoAlert SG</h4>
      </div>
      <p class="text-secondary small">Sign in to your private trader dashboard</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger py-2 small" role="alert">
        <%= error %>
      </div>
    <% } %>

    <% if (registered) { %>
      <div class="alert alert-success py-2 small" role="alert">
        Registration successful! Please log in with your credentials.
      </div>
    <% } %>

    <form method="POST" action="/login">
      <input type="hidden" name="redirect" value="<%= redirectUrl %>">
      
      <div class="mb-3">
        <label for="username" class="form-label small fw-semibold">Username or Email</label>
        <input
          type="text"
          class="form-control"
          id="username"
          name="username"
          placeholder="e.g. leekwan"
          required
          autofocus
        >
      </div>

      <div class="mb-3">
        <label for="password" class="form-label small fw-semibold">Password</label>
        <input
          type="password"
          class="form-control"
          id="password"
          name="password"
          placeholder="••••••••"
          required
        >
      </div>

      <!-- Remember Me Checkbox -->
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="rememberMe">
        <label class="form-check-label small text-secondary" for="rememberMe">
          Remember my username / email
        </label>
      </div>

      <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mt-2 shadow-sm">
        Sign In
      </button>
    </form>

    <div class="text-center mt-3 pt-3 border-top border-secondary-subtle small text-secondary">
      <span>Don't have an account? </span>
      <a href="/register" class="fw-semibold text-primary text-decoration-none">Create Account</a>
    </div>

    <div class="mt-3 text-center">
      <small class="text-muted" style="font-size: 0.72rem;">
        Default Seed Accounts: <code>leekwan</code> or <code>trader_sg</code> / <code>password123</code>
      </small>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Remember Me LocalStorage Logic -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const usernameInput = document.getElementById('username');
      const rememberCheckbox = document.getElementById('rememberMe');
      const loginForm = document.querySelector('form');

      // 1. Populate saved username if exists in localStorage
      const savedUser = localStorage.getItem('crypto_alerts_remembered_user');
      if (savedUser && usernameInput) {
        usernameInput.value = savedUser;
        if (rememberCheckbox) rememberCheckbox.checked = true;
        // Focus password input if username is already filled
        const passwordInput = document.getElementById('password');
        if (passwordInput) passwordInput.focus();
      }

      // 2. On form submit, update or clear localStorage
      if (loginForm) {
        loginForm.addEventListener('submit', () => {
          if (rememberCheckbox && rememberCheckbox.checked) {
            localStorage.setItem('crypto_alerts_remembered_user', usernameInput.value.trim());
          } else {
            localStorage.removeItem('crypto_alerts_remembered_user');
          }
        });
      }
    });
  </script>
</body>
</html>
