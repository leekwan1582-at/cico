DB_NAME=crypto_alerts_db
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_PORT=3306

# Chart Timeframe Configuration
CHART_DEFAULT_TIMEFRAME=7D
CHART_SUPPORTED_TIMEFRAMES=7D,30D,180D

# Automated Background Cron Scheduler Configuration
CRON_ENABLED=true
CRON_SCHEDULE_TYPE=HOURLY
CRON_INTERVAL_MINUTES=60

# JWT Authentication & Session Secret
JWT_SECRET=your_jwt_signing_secret_here
JWT_EXPIRES_IN_HOURS=24

# Gemini AI Deep Analysis Configuration (Optional)
# Supported models: gemini-3.1-flash-lite, gemini-3.8-flash, gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

